-atmosphere{animation:a-atmosphere-active .9s ease-in-out infinite alternate}
.voice-a-container.voice-active .voice-a-halo{animation:a-halo-active 1.45s ease-in-out infinite alternate}
.voice-a-container.voice-active .voice-a-logo{filter:drop-shadow(0 0 18px rgba(var(--voice-a-primary-rgb),.55)) drop-shadow(0 0 32px rgba(var(--voice-a-glow-rgb),.24));transform:scale(calc(1.03 + var(--vl,0)*.12))}
.voice-a-container.voice-active .voice-a-trail{animation:a-trail-active 2.8s ease-in-out infinite}
@keyframes a-atmosphere-breathe{0%,100%{transform:scale(.88);opacity:.55}50%{transform:scale(1.08);opacity:.9}}
@keyframes a-atmosphere-active{0%{transform:scale(.93);opacity:.62}100%{transform:scale(1.18);opacity:1}}
@keyframes a-halo-breathe{0%,100%{transform:scale(.94);opacity:.40}50%{transform:scale(1.04);opacity:.78}}
@keyframes a-halo-active{0%{transform:scale(.98);opacity:.50}100%{transform:scale(1.10);opacity:.95}}
@keyframes a-trail-drift{0%,100%{transform:rotate(-11deg) scale(.96);opacity:.34}50%{transform:rotate(3deg) scale(1.02);opacity:.72}}
@keyframes a-trail-active{0%,100%{transform:rotate(-11deg) scale(.96);opacity:.40}50%{transform:rotate(7deg) scale(1.06);opacity:.92}}
@keyframes a-energy-flow{to{stroke-dashoffset:-100}}

/* Engine Status Mini-Pill */
.voice-engine-pill{display:inline-flex;align-items:center;gap:6px;padding:4px 11px;border-radius:999px;background:rgba(24,20,34,.78);border:1px solid rgba(255,255,255,.10);font-size:10.5px;color:#c9bfd6;backdrop-filter:blur(10px)}
.voice-engine-dot{width:6px;height:6px;border-radius:50%;background:#34d399;flex:none}
.voice-engine-dot.loading{background:#fbbf24;animation:vp-blink 1s infinite}

/* DUAL LIVE CAPTIONS (USER + AI) */
.voice-captions-stage{width:min(640px,100%);display:flex;flex-direction:column;gap:7px;z-index:3}
.voice-captions-stage.hidden-cc{display:none}
.cap-card{background:rgba(20,16,29,.78);border:1px solid rgba(255,255,255,.11);border-radius:15px;padding:9px 13px;backdrop-filter:blur(16px);box-shadow:0 8px 28px rgba(0,0,0,.35);transition:border-color .25s,background .25s}
.cap-card.user-cap{border-left:3px solid rgba(var(--voice-a-primary-rgb),.75)}
.cap-card.ai-cap{border-left:3px solid rgba(var(--voice-a-glow-rgb),.85);max-height:132px;overflow-y:auto;scrollbar-width:thin;scrollbar-color:rgba(255,255,255,.2) transparent}
.cap-card.is-live{border-color:rgba(var(--voice-a-primary-rgb),.7);background:rgba(30,23,46,.90)}
.cap-card.ai-cap.is-live{border-color:rgba(var(--voice-a-glow-rgb),.7)}
.cap-header{display:flex;align-items:center;justify-content:space-between;font-size:10px;font-weight:700;letter-spacing:.7px;text-transform:uppercase;color:#a59cb2;margin-bottom:3px}
.cap-who{display:inline-flex;align-items:center;gap:6px}
.cap-eq{display:inline-flex;align-items:flex-end;gap:2px;height:10px;opacity:0;transition:opacity .2s}
.cap-card.is-live .cap-eq{opacity:1}
.cap-eq i{display:block;width:2px;height:4px;background:var(--voice-a-glow);border-radius:2px;animation:eq-dance .55s ease-in-out infinite alternate}
.cap-eq i:nth-child(2){animation-delay:.15s;height:8px}
.cap-eq i:nth-child(3){animation-delay:.3s;height:6px}
@keyframes eq-dance{0%{height:3px}100%{height:10px}}
.cap-text{font-size:13px;line-height:1.45;color:#f3eef9;overflow-wrap:anywhere}
.cap-text.interim{color:#d8b4fe;font-style:italic}
.cap-text.placeholder{color:#787085;font-size:12px}
.cap-chunk{transition:color .2s,background .2s;border-radius:4px;padding:0 2px}
.cap-chunk.spoken{color:#9a91a8}
.cap-chunk.active{color:#fff;background:rgba(var(--voice-a-primary-rgb),.34);box-shadow:0 0 12px rgba(var(--voice-a-primary-rgb),.24)}
.cap-chunk.upcoming{color:#dcd5e6}

/* PRIMARY TACTILE PUSH / TURN ACTION BUTTON (CHATGPT / GEMINI LIVE STYLE) */
.voice-push-wrap{display:flex;flex-direction:column;align-items:center;gap:5px;margin-top:2px;z-index:4}
.voice-push-btn{position:relative;display:inline-flex;align-items:center;justify-content:center;gap:9px;min-width:210px;height:50px;padding:0 22px;border-radius:999px;border:1px solid rgba(255,255,255,.18);background:rgba(28,22,42,.92);color:#fff;font-size:13.5px;font-weight:600;cursor:pointer;box-shadow:0 8px 28px rgba(0,0,0,.45);transition:transform .14s,background .2s,border-color .2s,box-shadow .2s;overflow:hidden;user-select:none;-webkit-user-select:none}
.voice-push-btn:hover{transform:translateY(-1px);border-color:rgba(255,255,255,.32)}
.voice-push-btn:active{transform:scale(.97)}
.voice-push-btn.state-listening{background:linear-gradient(135deg,rgba(var(--voice-a-primary-rgb),.35),rgba(var(--voice-a-primary-rgb),.18));border-color:rgba(var(--voice-a-primary-rgb),.8);box-shadow:0 0 24px rgba(var(--voice-a-primary-rgb),.3)}
.voice-push-btn.state-push-ready{background:var(--send-bg);border-color:rgba(255,255,255,.35);box-shadow:0 0 28px rgba(var(--voice-a-primary-rgb),.5)}
.voice-push-btn.state-speaking{background:rgba(255,215,0,.16);border-color:rgba(var(--voice-a-glow-rgb),.65);color:#fef08a}
.voice-push-btn.state-thinking{background:rgba(255,255,255,.07);border-color:rgba(255,255,255,.16);color:#d6cee0}
.push-auto-bar{position:absolute;left:0;bottom:0;height:3px;width:0%;background:linear-gradient(90deg,var(--voice-a-primary),var(--voice-a-glow));transition:width .1s linear;pointer-events:none}

.voice-bottom{position:relative;padding:4px 14px calc(14px + env(safe-area-inset-bottom));z-index:4;background:linear-gradient(transparent,rgba(3,1,8,.9) 28%,#030108 82%)}
.voice-prompt{display:flex;align-items:center;justify-content:center;gap:8px;text-align:center;color:#bbb3c7;font-size:12px;margin-bottom:8px;letter-spacing:.2px;min-height:18px}
.vp-dot{width:8px;height:8px;border-radius:50%;background:#555;flex:none;transition:background .25s,box-shadow .25s}
.voice-overlay[data-vstate="listening"] .vp-dot{background:var(--voice-a-primary);box-shadow:0 0 10px rgba(var(--voice-a-primary-rgb),.9);animation:vp-blink 1.4s ease-in-out infinite}
.voice-overlay[data-vstate="thinking"] .vp-dot{background:var(--voice-a-glow);animation:vp-blink 1.6s ease-in-out infinite}
.voice-overlay[data-vstate="speaking"] .vp-dot{background:var(--voice-a-glow);box-shadow:0 0 12px rgba(var(--voice-a-glow-rgb),.9);animation:vp-blink .7s ease-in-out infinite}
@keyframes vp-blink{0%,100%{opacity:.45;transform:scale(.8)}50%{opacity:1;transform:scale(1.15)}}
.voice-overlay[data-vstate="thinking"] .voice-a-logo{animation:a-think-pulse 2s ease-in-out infinite}
@keyframes a-think-pulse{0%,100%{transform:scale(.97);filter:drop-shadow(0 0 9px rgba(var(--voice-a-primary-rgb),.30))}50%{transform:scale(1.035);filter:drop-shadow(0 0 22px rgba(var(--voice-a-primary-rgb),.6)) drop-shadow(0 0 32px rgba(var(--voice-a-glow-rgb),.22))}}
.voice-overlay[data-vstate="muted"] .voice-core-wrap,.voice-overlay[data-vstate="standby"] .voice-core-wrap{opacity:.72;filter:saturate(.6)}

.voice-controls{display:flex;justify-content:center;gap:10px;margin-bottom:9px}
.voice-ctl{width:42px;height:42px;border-radius:50%;border:1px solid rgba(255,255,255,.14);background:#1b1724;color:#fff;font-size:16px;display:grid;place-items:center;cursor:pointer;transition:opacity .15s,background .15s,transform .12s}
.voice-ctl:hover:not(:disabled){background:#2a2438;transform:translateY(-1px)}
.voice-ctl:disabled{opacity:.32;cursor:not-allowed}
.voice-ctl.off{opacity:.65;border-color:rgba(255,120,120,.55)}

.voice-input-row{max-width:640px;margin:0 auto;display:flex;align-items:center;gap:8px}
.voice-input-pill{flex:1;min-width:0;height:50px;border-radius:26px;border:1px solid rgba(255,255,255,.15);background:#1b1724;color:#fff;display:flex;align-items:center;gap:8px;padding:0 10px 0 15px;font-size:14px;box-shadow:0 8px 30px rgba(0,0,0,.45)}
.voice-input-pill:focus-within{border-color:rgba(var(--voice-a-primary-rgb),.7)}
.voice-text-input{flex:1;min-width:0;border:0;outline:0;background:transparent;color:#fff;font-size:13.5px}
.voice-text-input::placeholder{color:#9a91a8}
.voice-pill-send{width:32px;height:32px;border-radius:50%;border:0;background:var(--send-bg);color:#fff;font-weight:700;cursor:pointer;display:grid;place-items:center;flex:none;font-size:14px}
.voice-mic,.voice-close{width:50px;height:50px;border-radius:50%;border:1px solid rgba(255,255,255,.14);display:grid;place-items:center;cursor:pointer;font-size:20px;flex:none;position:relative;transition:transform .12s,background .15s}
.voice-mic{background:#1b1724;color:#fff}
.voice-mic.listening-ring{border-color:rgba(var(--voice-a-primary-rgb),.9);box-shadow:0 0 0 4px rgba(var(--voice-a-primary-rgb),.22)}
.voice-close{background:#fff;color:#000;font-size:28px}
.voice-mic.muted{opacity:.6}
.voice-mic.muted::after{content:"";position:absolute;left:50%;top:50%;width:26px;height:2px;border-radius:2px;background:#ff6b6b;transform:translate(-50%,-50%) rotate(-45deg)}

/* Voice Settings Sheet & Voice History Drawer */
.voice-settings,.voice-drawer{position:absolute;z-index:8;top:calc(68px + env(safe-area-inset-top));width:min(380px,calc(100% - 24px));max-height:calc(100% - 100px - env(safe-area-inset-top));overflow:auto;background:rgba(20,15,28,.98);border:1px solid rgba(255,255,255,.15);border-radius:18px;padding:16px;box-shadow:0 20px 70px #000;backdrop-filter:blur(18px);color:#eee;font-size:13px;accent-color:rgb(var(--voice-a-primary-rgb))}
.voice-settings{right:12px}
.voice-drawer{left:12px}
.voice-settings[hidden],.voice-drawer[hidden]{display:none}
.vs-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;font-size:15px}
.vs-close{border:0;background:transparent;color:#fff;font-size:24px;line-height:1;cursor:pointer}
.vs-row{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:9px 0;border-bottom:1px solid var(--border);cursor:pointer}
.vs-switch{appearance:none;-webkit-appearance:none;width:42px;height:24px;border-radius:12px;background:#3a3342;position:relative;cursor:pointer;flex:none;border:0;transition:background .2s}
.vs-switch::after{content:"";position:absolute;top:3px;left:3px;width:18px;height:18px;border-radius:50%;background:#fff;transition:transform .2s,background .2s}
.vs-switch:checked{background:rgb(var(--voice-a-primary-rgb))}
.vs-switch:checked::after{transform:translateX(18px);background:#0b0610}
.vs-field{padding:9px 0 2px}
.vs-field label{display:flex;justify-content:space-between;color:#bdb5c6;font-size:12px;margin-bottom:5px}
.vs-field select{width:100%;background:#120e18;color:#fff;border:1px solid var(--border);border-radius:10px;padding:8px 10px;font-size:12.5px}
.vs-field select option{background:#120e18}
.vs-field input[type=range]{width:100%}
.vs-local-box{margin-top:10px;padding:10px;border-radius:12px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09)}
.vs-local-row{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:11.5px;margin-bottom:7px}
.vs-local-row:last-child{margin-bottom:0}
.vs-mini-btn{border:1px solid rgba(var(--voice-a-primary-rgb),.5);background:rgba(var(--voice-a-primary-rgb),.18);color:#fff;border-radius:8px;padding:4px 9px;font-size:11px;font-weight:600;cursor:pointer}
.vs-mini-btn:hover{background:rgba(var(--voice-a-primary-rgb),.32)}
.vs-mini-btn.ready{border-color:rgba(52,211,153,.5);background:rgba(52,211,153,.16);color:#a7f3d0}
.vs-progress{margin-top:8px;background:rgba(255,255,255,.06);border-radius:8px;padding:8px 10px;font-size:11px;color:#d6cee0}
.vs-progress[hidden]{display:none}
.vs-bar{height:5px;border-radius:99px;background:rgba(255,255,255,.12);overflow:hidden;margin-top:5px}
.vs-bar > i{display:block;height:100%;width:0%;background:linear-gradient(90deg,var(--voice-a-primary),var(--voice-a-glow));transition:width .2s}
.vs-test{margin-top:11px;width:100%;padding:10px;border-radius:12px;border:1px solid var(--border);background:rgba(255,255,255,.07);color:#fff;cursor:pointer;font-weight:500}
.vs-test:hover{background:rgba(255,255,255,.13)}
.vs-note{margin-top:8px;font-size:11px;color:#ffb3b3;line-height:1.4}
.vs-note:empty{display:none}
.vd-item{padding:9px 10px;border-radius:10px;background:rgba(255,255,255,.04);margin-bottom:7px;font-size:12px;line-height:1.45}
.vd-item b{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.5px;color:var(--voice-a-glow);margin-bottom:2px}
.vd-item.u b{color:#c4b5fd}

@media(max-height:700px){
  .voice-core-wrap{width:125px;height:125px}
  .cap-card.ai-cap{max-height:85px}
  .voice-push-btn{height:44px;font-size:12.5px}
  .voice-ctl{width:38px;height:38px;font-size:15px}
}
@media (prefers-reduced-motion:reduce){
  .voice-a-atmosphere,.voice-a-halo,.voice-a-trail,.voice-a-energy,.vp-dot,.cap-eq i,.processing{animation:none!important}
}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar" id="sidebar">
  <div class="brand"><div class="logo">A</div><div><b>Angelin AI</b><small>Personal AI assistant</small></div></div>
  <div class="history-section"><div class="history-label">Pinned</div><div class="history compact-history" id="pinnedHistory"></div></div>
  <div class="history-section recent-section"><div class="history-label">Recents</div><div class="history compact-history" id="recentHistory"></div></div>
  <div class="sidebar-spacer"></div>
  <div class="side-bottom">
    <button class="new-chat" id="newChat">✎ &nbsp; New chat</button>
    <button class="side-btn" id="settingsBtn">⚙️ Settings</button>
    <button class="side-btn" id="clearBtn">🗑️ Clear history</button>
  </div>
</aside>
<div class="overlay" id="overlay"></div>
<main class="main">
<header class="topbar">
  <div class="top-left">
    <button class="top-btn menu" id="menuBtn" aria-label="Toggle sidebar">☰</button>
    <select class="model" id="modelSelect">
      <option value="taka-flash-8b">⚡ Angelin Flash 8B · Instant</option>
      <option value="taka-max-120b">🧠 Angelin Max 120B · Ultra Intelligence</option>
      <option value="taka-ultra-70b">🚀 Angelin Ultra 70B · Versatile Engine</option>
      <option value="taka-qwen-27b">💻 Angelin Qwen 27B · Code & Math</option>
      <option value="taka-pro-20b">⚡ Angelin Pro 20B · High Speed</option>
    </select>
  </div>
  <div class="top-right">
    <button class="top-btn top-voice-pill" id="topVoiceBtn" title="Start Live Voice Conversation">🎙️ Live</button>
    <button class="top-btn share" id="shareBtn" title="Share chat">↗</button>
  </div>
</header>
<section class="chat" id="chat">
  <div class="messages" id="messages">
    <div class="empty" id="empty">
      <h1>What can I help with?</h1>
      <p>Ask Angelin AI anything — by text or ChatGPT/Gemini-style live voice.</p>
      <div class="suggestions">
        <button class="suggestion">💡 Explain something simply</button>
        <button class="suggestion">💻 Help me write code</button>
        <button class="suggestion">📝 Write or improve text</button>
        <button class="suggestion">🧮 Solve a math problem</button>
      </div>
    </div>
  </div>
</section>
</main>
<div class="composer-wrap">
  <div class="composer">
    <div class="attach-bar" id="attachBar"></div>
    <div class="input-area">
      <input type="file" id="fileInput" class="file-input" multiple>
      <button class="round" id="attachBtn" title="Attach files">＋</button>
      <textarea id="input" rows="1" placeholder="Message Angelin AI..." autocomplete="off"></textarea>
      <button class="round" id="micBtn" title="Live Voice Conversation">🎙️</button>
      <button class="round send" id="sendBtn" title="Send message" aria-label="Send">↑</button>
    </div>
    <div class="tools">
      <div class="tools-left">
        <button class="tool" id="webBtn">🌐 Web OFF</button>
        <button class="tool" id="streamBtn">⚡ Stream ON</button>
        <button class="tool" id="speakStopBtn" hidden>🔇 Stop speaking</button>
      </div>
      <span>Angelin AI may generate inaccurate info. Check facts.</span>
    </div>
  </div>
</div>
</div>

<!-- LIVE VOICE CONVERSATION OVERLAY (CHATGPT / GEMINI LIVE TURN-TAKING + LOCAL ENGINES) -->
<div class="voice-overlay" id="voiceOverlay" aria-hidden="true">
  <canvas id="voiceCanvas" aria-hidden="true"></canvas>

  <div class="voice-top">
    <div class="voice-top-left">
      <button type="button" class="voice-circle" id="voiceMenuBtn" aria-label="Voice transcript history" title="Conversation log">☰</button>
      <div class="voice-mode-switch" role="tablist" aria-label="Conversation mode">
        <button type="button" class="vm-tab active" id="modeLiveAutoBtn" role="tab" aria-selected="true">✨ Live Auto</button>
        <button type="button" class="vm-tab" id="modePushBtn" role="tab" aria-selected="false">🎙️ Push</button>
      </div>
    </div>
    <div class="voice-top-right">
      <button type="button" class="voice-circle voice-cc-btn active" id="voiceCCBtn" aria-label="Toggle live captions" aria-pressed="true" title="Show/Hide Live Captions">CC</button>
      <button type="button" class="voice-circle" id="voiceSettingsBtn" aria-label="Voice settings" title="Local Engines & Settings">⚙️</button>
    </div>
  </div>

  <!-- Voice Conversation Log Drawer -->
  <div class="voice-drawer" id="voiceDrawer" hidden role="dialog" aria-label="Voice transcript">
    <div class="vs-head"><b>Voice Transcript</b><button type="button" class="vs-close" id="voiceDrawerClose" aria-label="Close transcript">×</button></div>
    <div id="voiceDrawerList"></div>
  </div>

  <!-- Voice & Local Engines Settings Sheet -->
  <div class="voice-settings" id="voiceSettingsPanel" hidden role="dialog" aria-label="Voice settings">
    <div class="vs-head"><b>Local Voice &amp; Speech Engines</b><button type="button" class="vs-close" id="voiceSettingsClose" aria-label="Close voice settings">×</button></div>

    <div class="vs-field">
      <label for="vsTtsEngine">Local TTS Engine (100% Free)</label>
      <select id="vsTtsEngine">
        <option value="auto">Auto (Kokoro-82M Local AI + Device Neural)</option>
        <option value="kokoro">Kokoro-82M Neural AI (Local WASM/WebGPU)</option>
        <option value="speecht5">SpeechT5 Neural AI (Local WASM)</option>
        <option value="system">Device Local Neural Voice (Instant / Hindi)</option>
      </select>
    </div>

    <div class="vs-field" id="kokoroVoiceWrap">
      <label for="vsKokoroVoice">Kokoro-82M Voice</label>
      <select id="vsKokoroVoice">
        <option value="af_heart">Heart — Warm &amp; Expressive (Female)</option>
        <option value="af_bella">Bella — Soft &amp; Natural (Female)</option>
        <option value="af_nicole">Nicole — Calm &amp; Intimate (Female)</option>
        <option value="af_sky">Sky — Bright &amp; Friendly (Female)</option>
        <option value="bf_emma">Emma — British Clear (Female)</option>
        <option value="am_adam">Adam — Deep &amp; Natural (Male)</option>
        <option value="am_michael">Michael — Warm Conversational (Male)</option>
      </select>
    </div>

    <div class="vs-field">
      <label for="vsSttEngine">Local STT Engine (100% Free)</label>
      <select id="vsSttEngine">
        <option value="whisper-tiny">Whisper-Tiny AI (100% Local Offline — Recommended)</option>
        <option value="whisper-base">Whisper-Base AI (100% Local High-Accuracy)</option>
        <option value="browser">Browser Live Speech (Zero-Download Streaming)</option>
      </select>
    </div>

    <!-- Local Model Preload / Cache Controls -->
    <div class="vs-local-box">
      <div class="vs-local-row">
        <span>🧠 Local Kokoro TTS</span>
        <button type="button" class="vs-mini-btn" id="btnPreloadTTS">Download / Ready</button>
      </div>
      <div class="vs-local-row">
        <span>🎧 Local Whisper STT</span>
        <button type="button" class="vs-mini-btn" id="btnPreloadSTT">Download / Ready</button>
      </div>
    </div>

    <div class="vs-progress" id="vsModelProgress" hidden>
      <div id="vsModelStatus">Preparing local AI speech model…</div>
      <div class="vs-bar"><i id="vsModelBar"></i></div>
    </div>

    <div class="vs-field">
      <label for="vsAutoPushDelay"><span>Auto-Push Silence Delay</span><output id="vsAutoPushVal"></output></label>
      <input type="range" id="vsAutoPushDelay" min="0.9" max="3.0" step="0.1">
    </div>

    <label class="vs-row"><span>Auto-speak Angelin's replies</span><input type="checkbox" class="vs-switch" id="vsAutoSpeak"></label>
    <label class="vs-row"><span>Also speak in text chat</span><input type="checkbox" class="vs-switch" id="vsSpeakChat"></label>

    <div class="vs-field">
      <label for="vsLang">Spoken Language</label>
      <select id="vsLang">
        <option value="en-IN">English (India)</option>
        <option value="en-US">English (US)</option>
        <option value="hi-IN">Hindi (हिन्दी)</option>
      </select>
    </div>
    <div class="vs-field"><label for="vsVoice">Device Local Fallback Voice</label><select id="vsVoice"></select></div>
    <div class="vs-field"><label for="vsRate"><span>Speech Speed</span><output id="vsRateVal"></output></label><input type="range" id="vsRate" min="0.6" max="1.8" step="0.05"></div>
    <div class="vs-field"><label for="vsPitch"><span>Device Pitch</span><output id="vsPitchVal"></output></label><input type="range" id="vsPitch" min="0.6" max="1.6" step="0.05"></div>
    <div class="vs-field"><label for="vsVolume"><span>Volume</span><output id="vsVolumeVal"></output></label><input type="range" id="vsVolume" min="0" max="1" step="0.05"></div>
    <button type="button" class="vs-test" id="vsTest">▶ Test Voice Output</button>
    <p class="vs-note" id="vsNote"></p>
  </div>

  <!-- CENTER STAGE: REACTIVE A ORB + ENGINE PILL + DUAL LIVE CAPTIONS + MANUAL PUSH BUTTON -->
  <div class="voice-stage">
    <div class="voice-core-wrap">
      <div class="voice-a-container" id="voiceAContainer">
        <div class="voice-a-atmosphere"></div>
        <div class="voice-a-halo"></div>
        <div class="voice-a-trail"></div>
        <svg class="voice-a-logo" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Angelin AI A logo">
          <defs>
            <filter id="voiceGlow" x="-80%" y="-80%" width="260%" height="260%">
              <feGaussianBlur stdDeviation="2.8" result="blur" />
              <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
            </filter>
            <linearGradient id="aGradient" x1="24" y1="18" x2="96" y2="102" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="var(--voice-a-primary)" />
              <stop offset="52%" stop-color="var(--voice-a-primary)" />
              <stop offset="100%" stop-color="var(--voice-a-glow)" />
            </linearGradient>
            <linearGradient id="aCoreGradient" x1="34" y1="78" x2="86" y2="48" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="var(--voice-a-primary)" />
              <stop offset="100%" stop-color="var(--voice-a-glow)" />
            </linearGradient>
          </defs>
          <path class="a-glow" d="M60 13 L101 101 H84 L73.2 77 H46.8 L36 101 H19 L60 13 Z" stroke="var(--voice-a-glow)" stroke-width="9" stroke-linejoin="round" />
          <path class="a-main" d="M60 15 L98 100 H85 L73 74 H47 L35 100 H22 L60 15 Z" stroke="url(#aGradient)" stroke-width="4.6" stroke-linecap="round" stroke-linejoin="round" />
          <path class="a-inner" d="M44 61 H76" stroke="var(--voice-a-glow)" stroke-width="4.2" stroke-linecap="round" />
          <path class="a-energy" d="M46 62 H74" stroke="url(#aCoreGradient)" stroke-width="2.4" stroke-linecap="round" />
          <circle class="a-node" cx="60" cy="42" r="3.2" />
        </svg>
      </div>
    </div>

    <div class="voice-engine-pill" id="voiceEnginePill">
      <span class="voice-engine-dot" id="voiceEngineDot"></span>
      <span id="voiceEngineLabel">Kokoro TTS · Whisper Local STT</span>
    </div>

    <!-- DUAL LIVE CAPTIONS FOR USER & ANGELIN AI -->
    <div class="voice-captions-stage" id="voiceCaptionsStage" aria-live="polite">
      <div class="cap-card user-cap" id="userCapCard">
        <div class="cap-header">
          <span class="cap-who">🎙️ You <span class="cap-eq"><i></i><i></i><i></i></span></span>
          <span id="userCapBadge">Your Turn</span>
        </div>
        <div class="cap-text placeholder" id="userCapText">Speak now — auto-sends after you finish talking, or tap Push below…</div>
      </div>

      <div class="cap-card ai-cap" id="aiCapCard">
        <div class="cap-header">
          <span class="cap-who">✨ Angelin AI <span class="cap-eq"><i></i><i></i><i></i></span></span>
          <span id="aiCapBadge">Standby</span>
        </div>
        <div class="cap-text placeholder" id="aiCapText">Angelin’s reply and live spoken captions will appear here…</div>
      </div>
    </div>

    <!-- MANUAL PUSH / TURN-ACTION BUTTON (WORKS IN BOTH LIVE AUTO & PUSH MODES) -->
    <div class="voice-push-wrap">
      <button type="button" class="voice-push-btn state-listening" id="voicePushBtn">
        <span id="voicePushIcon">↑</span>
        <span id="voicePushLabel">Push &amp; Send Now</span>
        <span class="push-auto-bar" id="pushAutoBar"></span>
      </button>
    </div>
  </div>

  <!-- BOTTOM CONTROLS -->
  <div class="voice-bottom">
    <div class="voice-prompt"><span class="vp-dot" aria-hidden="true"></span><span id="voicePrompt" role="status" aria-live="polite">Your turn — speak now…</span></div>
    <div class="voice-controls">
      <button type="button" class="voice-ctl" id="voiceSpeakerBtn" aria-label="Mute speaker" aria-pressed="false" title="Speaker on/off">🔊</button>
      <button type="button" class="voice-ctl" id="voicePauseBtn" aria-label="Pause speaking" title="Pause / resume speaking" disabled>⏸</button>
      <button type="button" class="voice-ctl" id="voiceStopBtn" aria-label="Stop" title="Stop speaking / thinking" disabled>■</button>
    </div>
    <div class="voice-input-row">
      <div class="voice-input-pill">
        <input type="text" class="voice-text-input" id="voiceTextInput" placeholder="Or type to Angelin AI…" autocomplete="off">
        <button type="button" class="voice-pill-send" id="voicePillSendBtn" title="Send message" aria-label="Send">↑</button>
      </div>
      <button type="button" class="voice-mic" id="voiceMuteBtn" aria-label="Mute microphone" aria-pressed="false" title="Mic On/Off">🎙️</button>
      <button type="button" class="voice-close" id="voiceCloseBtn" aria-label="Close voice mode" title="Exit Live Voice">×</button>
    </div>
  </div>
</div>

<div class="history-menu" id="historyMenu"><button id="renameBtn">✏️ Rename chat</button><button id="pinBtn">📌 Pin / unpin</button><button id="deleteBtn" class="danger">🗑️ Delete chat</button></div>
<div class="modal" id="settings" hidden>
  <button class="close" id="closeSettings">×</button>
  <h3>Settings</h3>
  <div class="setting"><span>Streaming</span><button class="tool" id="streamSetting">ON</button></div>
  <div class="setting"><span>Web mode</span><button class="tool" id="webSetting">OFF</button></div>
  <div style="padding-top:14px">
    <b style="font-size:14px">🎨 Appearance</b>
    <div class="theme-grid">
      <button class="theme-card" data-theme="theme-purple-gold"><div class="theme-preview tp-purple"></div><div class="theme-name">Purple + Gold</div><div class="theme-desc">Deep space • purple</div></button>
      <button class="theme-card" data-theme="theme-blue-gold"><div class="theme-preview tp-blue"></div><div class="theme-name">Blue + Gold</div><div class="theme-desc">Premium blue</div></button>
      <button class="theme-card" data-theme="theme-white-royal"><div class="theme-preview tp-white"></div><div class="theme-name">Pure Black</div><div class="theme-desc">Totally dark</div></button>
      <button class="theme-card" data-theme="theme-pink-love"><div class="theme-preview tp-pink"></div><div class="theme-name">Pink Love</div><div class="theme-desc">Soft style</div></button>
    </div>
  </div>
</div>

<script>
const CHAT_API_URL = "/api/chat";
const HISTORY_KEY = "angelin_chats";
const THEME_KEY = "angelin_theme";

let isStreamingEnabled = true;
let isGenerating = false;
let webMode = false;
let menuChatId = null;
let activeController = null;
let recognition = null;
let isVoiceActive = false;
let animFrameId = null;
let attachedFiles = [];

let conversations = safeParse(localStorage.getItem(HISTORY_KEY), []);
let current = { id: Date.now(), title: "New chat", pinned: false, messages: [] };

const $ = id => document.getElementById(id);

function safeParse(val, fallback) { try { const p = JSON.parse(val); return Array.isArray(p) ? p : fallback; } catch { return fallback; } }
function esc(str) { return String(str ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;"); }

function normalizeBrand(text) {
  return String(text ?? "").replace(/taka\s*ai/gi, "Angelin AI");
}

function formatReply(text) {
  const codeBlocks = [];
  let clean = normalizeBrand(text);
  clean = clean.replace(/```(\w+)?\n([\s\S]*?)```/g, (_, lang, code) => {
    const idx = codeBlocks.length;
    codeBlocks.push({ lang: lang || "code", code });
    return `@@CODEBLOCK_${idx}@@`;
  });
  clean = clean.replace(/```([\s\S]*?)```/g, (_, code) => {
    const idx = codeBlocks.length;
    codeBlocks.push({ lang: "code", code });
    return `@@CODEBLOCK_${idx}@@`;
  });

  let s = esc(clean);
  s = s.replace(/^###\s+(.*)$/gm, "<h4>$1</h4>");
  s = s.replace(/^##\s+(.*)$/gm, "<h3>$1</h3>");
  s = s.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");
  s = s.replace(/`([^`\n]+)`/g, "<code>$1</code>");
  s = s.replace(/\n---+\n/g, "<hr>");
  s = s.replace(/^&gt;\s?(.*)$/gm, "<blockquote>$1</blockquote>");

  const blocks = s.split(/\n{2,}/).map(block => {
    const trimmed = block.trim();
    if (!trimmed) return "";
    if (/^@@CODEBLOCK_\d+@@$/.test(trimmed) || trimmed.startsWith("<blockquote>") || trimmed === "<hr>" || trimmed.startsWith("<h3>") || trimmed.startsWith("<h4>")) {
      return trimmed;
    }
    const lines = trimmed.split("\n");
    if (lines.every(l => /^\s*[-*•]\s+/.test(l))) {
      return "<ul>" + lines.map(l => "<li>" + l.replace(/^\s*[-*•]\s+/, "") + "</li>").join("") + "</ul>";
    }
    if (lines.every(l => /^\s*\d+\.\s+/.test(l))) {
      return "<ol>" + lines.map(l => "<li>" + l.replace(/^\s*\d+\.\s+/, "") + "</li>").join("") + "</ol>";
    }
    return "<p>" + trimmed.replace(/\n/g, "<br>") + "</p>";
  }).join("");

  return blocks.replace(/@@CODEBLOCK_(\d+)@@/g, (_, idx) => {
    const cb = codeBlocks[Number(idx)];
    if (!cb) return "";
    return `<div class="code-container"><div class="code-header"><span>${esc(cb.lang)}</span><button type="button" class="copy-code-btn" onclick="copyCode(this)">Copy code</button></div><pre><code>${esc(cb.code)}</code></pre></div>`;
  });
}

function copyCode(btn) {
  const code = btn.closest(".code-container").querySelector("code").innerText;
  navigator.clipboard.writeText(code).then(() => {
    btn.textContent = "Copied!";
    setTimeout(() => btn.textContent = "Copy code", 1800);
  });
}
function toast(msg) {
  const old = $("statusToast"); if (old) old.remove();
  const x = document.createElement("div");
  x.id = "statusToast";
  x.textContent = msg;
  x.style.cssText = "position:fixed;left:50%;bottom:96px;transform:translateX(-50%);background:#21182a;border:1px solid #3a3042;color:#fff;padding:9px 14px;border-radius:10px;z-index:1200;font-size:12px;box-shadow:0 8px 30px #000";
  document.body.appendChild(x);
  setTimeout(() => x.remove(), 1900);
}
function scroll() { const chat = $("chat"); chat.scrollTop = chat.scrollHeight; }
function save() { try { localStorage.setItem(HISTORY_KEY, JSON.stringify(conversations.slice(-100))); } catch {} }
function persist() {
  if (!current.messages.length) return;
  const idx = conversations.findIndex(c => c.id === current.id);
  if (idx >= 0) conversations[idx] = current;
  else conversations.push(current);
  save();
  renderHistory();
}

function newChat() {
  cancelSpeech();
  persist();
  current = { id: Date.now(), title: "New chat", pinned: false, messages: [] };
  $("messages").innerHTML = `<div class="empty" id="empty"><h1>What can I help with?</h1><p>Ask Angelin AI anything — by text or ChatGPT/Gemini-style live voice.</p><div class="suggestions"><button class="suggestion">💡 Explain something simply</button><button class="suggestion">💻 Help me write code</button><button class="suggestion">📝 Write or improve text</button><button class="suggestion">🧮 Solve a math problem</button></div></div>`;
  bindSuggestions();
  closeMenu();
  renderHistory();
  $("input").focus();
}
function historyRow(c) {
  const row = document.createElement("div");
  row.className = "history-item";
  const b = document.createElement("button");
  b.className = "history-open" + (c.id === current.id ? " active" : "");
  b.textContent = (c.pinned ? "📌 " : "") + (c.title || "New chat");
  b.onclick = () => loadChat(c.id);
  const m = document.createElement("button");
  m.className = "history-more";
  m.textContent = "⋯";
  m.onclick = e => { e.stopPropagation(); openHistoryMenu(e.currentTarget, c.id); };
  row.append(b, m);
  return row;
}
function renderHistory() {
  const pinned = $("pinnedHistory"), recent = $("recentHistory");
  pinned.innerHTML = "";
  recent.innerHTML = "";
  const all = [...conversations].sort((a, b) => b.id - a.id);
  all.filter(c => c.pinned).forEach(c => pinned.appendChild(historyRow(c)));
  all.filter(c => !c.pinned).forEach(c => recent.appendChild(historyRow(c)));
}
function loadChat(id) {
  cancelSpeech();
  persist();
  const found = conversations.find(x => x.id === id);
  if (!found) return;
  current = JSON.parse(JSON.stringify(found));
  $("messages").innerHTML = "";
  if (!current.messages.length) newChat();
  else current.messages.forEach(m => renderMessage(m.role, m.content, m.viaVoice));
  scroll();
  closeMenu();
  renderHistory();
}

function renderMessage(role, text, viaVoice = false) {
  $("empty")?.remove();
  const x = document.createElement("div");
  x.className = "message " + (role === "user" ? "user" : "ai");
  const content = role === "user" ? esc(text).replace(/\n/g, "<br>") : formatReply(text);
  const voiceTag = viaVoice ? '<span class="voice-badge">🎙️ Live</span>' : "";
  x.innerHTML = `<div class="avatar">${role === "user" ? "U" : "A"}</div><div class="bubble"><div class="meta">${role === "user" ? "You" : "✨ Angelin AI"} ${voiceTag}</div><div class="content">${content}</div><div class="message-actions"><button type="button" data-action="copy">Copy</button>${role === "assistant" ? '<button type="button" data-action="speak">🔊 Listen</button><button type="button" data-action="regenerate">Regenerate</button>' : ''}</div></div>`;
  $("messages").appendChild(x);
  x.querySelector('[data-action="copy"]')?.addEventListener("click", () => {
    navigator.clipboard.writeText(x.querySelector(".content").innerText).then(() => toast("Copied"));
  });
  x.querySelector('[data-action="speak"]')?.addEventListener("click", () => {
    const raw = x.querySelector(".content").innerText;
    const spoken = cleanForSpeech(raw);
    if (spoken) startSpeech(spoken);
  });
  x.querySelector('[data-action="regenerate"]')?.addEventListener("click", () => {
    const idx = [...$("messages").children].indexOf(x);
    regenerateFromAI(idx);
  });
  return x;
}

async function regenerateFromAI(aiIdx) {
  if (isGenerating) return;
  let userBefore = -1;
  for (let i = aiIdx - 1; i >= 0; i--) {
    if (current.messages[i]?.role === "user") { userBefore = i; break; }
  }
  if (userBefore < 0) return;
  current.messages = current.messages.slice(0, userBefore + 1);
  $("messages").innerHTML = "";
  current.messages.forEach(m => renderMessage(m.role, m.content, m.viaVoice));
  persist();
  await generate(current.messages[userBefore].content);
}

function stopGeneration() { if (activeController && isGenerating) activeController.abort(); }
function setGeneratingUI(on) {
  const send = $("sendBtn");
  if (on) { send.classList.add("stop-active"); send.onclick = stopGeneration; }
  else { send.classList.remove("stop-active"); send.onclick = () => sendMessage(false); }
}

async function sendMessage(viaVoice = false) {
  const input = $("input");
  let text = input.value.trim();
  if ((!text && !attachedFiles.length) || isGenerating) return;

  if (attachedFiles.length) {
    const fileContext = attachedFiles.map(f => f.snippet ? `[File: ${f.name}]\n\`\`\`\n${f.snippet}\n\`\`\`` : `[Attached File: ${f.name}]`).join("\n\n");
    text = text ? `${text}\n\n${fileContext}` : fileContext;
    attachedFiles = [];
    renderAttachBar();
  }

  input.value = "";
  resizeInput();
  current.messages.push({ role: "user", content: text, viaVoice });
  renderMessage("user", text, viaVoice);
  if (current.title === "New chat") current.title = text.slice(0, 42);
  persist();
  scroll();
  if (isVoiceActive) renderVoiceDrawer();
  await generate(text, viaVoice);
}

async function generate(userText, viaVoice = false) {
  isGenerating = true;
  activeController = new AbortController();
  setGeneratingUI(true);
  const node = renderMessage("assistant", "", viaVoice);
  node.querySelector(".content").innerHTML = '<span class="processing">Angelin AI is thinking…</span>';
  scroll();
  let answer = "";
  let vOutcome = "error";
  voiceBeforeGenerate();
  try {
    const voiceHint = viaVoice ? "\nVOICE MODE: Respond naturally and concisely (2–4 short conversational sentences unless the user asks for code or a detailed breakdown)." : "";
    const webHint = webMode ? "\nWEB MODE: Prioritize current, up-to-date facts and note uncertainties if live browsing is unavailable." : "";
    const sys = `You are Angelin AI, a helpful and intelligent AI assistant. IDENTITY: Your name is Angelin AI. You were created by Bhavishya. If asked who made you, answer: "I was made by Bhavishya." Never claim that Takadori created you. Never confuse your creator with your user. Do not mention Taka AI. Be natural, intelligent, friendly and accurate.${voiceHint}${webHint}`;
    const reqModel = $("modelSelect").value;
    const apiMessages = current.messages.map(m => ({ role: m.role, content: m.content }));
    if (window.location.protocol === "file:") {
      throw new Error("Deploy on Vercel (or run `vercel dev`) so /api/chat can securely attach TAKA_API_KEY.");
    }
    const makeReq = m => fetch(CHAT_API_URL, {
      method: "POST",
      signal: activeController.signal,
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ model: m, messages: [{ role: "system", content: sys }, ...apiMessages], stream: isStreamingEnabled })
    });
    let res = await makeReq(reqModel);
    if (!res.ok && res.status !== 401 && res.status !== 403 && reqModel !== "taka-flash-8b") {
      res = await makeReq("taka-flash-8b");
    }
    if (!res.ok) {
      let errMsg = "HTTP " + res.status;
      try {
        const errBody = await res.json();
        if (errBody && errBody.error) errMsg = errBody.error;
      } catch {}
      throw new Error(errMsg);
    }

    if (isStreamingEnabled) {
      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buffer = "";
      node.querySelector(".content").innerHTML = "";
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        buffer += decoder.decode(value, { stream: true });
        const parts = buffer.split("\n");
        buffer = parts.pop() || "";
        for (const line of parts) {
          if (!line.startsWith("data:")) continue;
          const payload = line.slice(5).trim();
          if (payload === "[DONE]") continue;
          try {
            const parsed = JSON.parse(payload);
            const delta = parsed?.choices?.[0]?.delta?.content;
            if (delta) {
              answer += delta;
              node.querySelector(".content").innerHTML = formatReply(answer);
              if (isVoiceActive) updateLiveAICaption(cleanForSpeech(answer), -1, true);
              scroll();
            }
          } catch {}
        }
      }
    } else {
      const data = await res.json();
      answer = data?.choices?.[0]?.message?.content || "";
      node.querySelector(".content").innerHTML = formatReply(answer);
    }
    current.messages.push({ role: "assistant", content: answer, viaVoice });
    persist();
    if (isVoiceActive) renderVoiceDrawer();
    vOutcome = "ok";
  } catch (err) {
    if (err.name === "AbortError") {
      vOutcome = "aborted";
      node.querySelector(".content").innerHTML = answer ? formatReply(answer) : "⏹️ Generation stopped.";
    } else {
      const detail = err && err.message ? `<br><small style="opacity:.75">${esc(err.message)}</small>` : "";
      node.querySelector(".content").innerHTML = "❌ Failed to connect to Angelin AI." + detail;
    }
  } finally {
    isGenerating = false;
    activeController = null;
    setGeneratingUI(false);
    scroll();
    voiceAfterGenerate(vOutcome, answer);
  }
}

/* File attachments */
function renderAttachBar() {
  const bar = $("attachBar");
  bar.innerHTML = "";
  attachedFiles.forEach((f, idx) => {
    const chip = document.createElement("span");
    chip.className = "attach-chip";
    chip.innerHTML = `📎 ${esc(f.name)} <button type="button" aria-label="Remove attachment">×</button>`;
    chip.querySelector("button").onclick = () => { attachedFiles.splice(idx, 1); renderAttachBar(); };
    bar.appendChild(chip);
  });
}
$("attachBtn").onclick = () => $("fileInput").click();
$("fileInput").onchange = async e => {
  const files = Array.from(e.target.files || []);
  for (const file of files) {
    let snippet = "";
    if (file.size < 120000 && /\.(txt|md|js|ts|py|html|css|json|csv|xml|yaml|yml|java|kt|cpp|c|sh|sql)$/i.test(file.name)) {
      try { snippet = (await file.text()).slice(0, 8000); } catch {}
    }
    attachedFiles.push({ name: file.name, snippet });
  }
  renderAttachBar();
  if (files.length) toast(`${files.length} file(s) attached`);
  e.target.value = "";
};

/* ==========================================================================================
   100% LOCAL IN-BROWSER AI WORKER (Kokoro-82M TTS, SpeechT5 TTS, Whisper-Tiny & Whisper-Base STT)
   ========================================================================================== */
const NEURAL_WORKER_CODE = `
let kokoroTTS = null;
let kokoroLoading = null;
let speechT5Pipe = null;
let speechT5Loading = null;
let whisperPipes = {};
let whisperLoading = {};

async function ensureKokoro() {
  if (kokoroTTS) return kokoroTTS;
  if (kokoroLoading) return kokoroLoading;
  kokoroLoading = (async () => {
    self.postMessage({ type: "model_progress", target: "tts", engine: "kokoro", pct: 5, status: "Loading Kokoro-82M Local TTS…" });
    const { KokoroTTS } = await import("https://cdn.jsdelivr.net/npm/kokoro-js@1.2.1/+esm");
    const hasWebGPU = typeof navigator !== "undefined" && !!navigator.gpu;
    const progress_callback = p => {
      if (p && typeof p.progress === "number") {
        self.postMessage({ type: "model_progress", target: "tts", engine: "kokoro", pct: Math.round(p.progress), status: "Downloading Kokoro-82M (" + Math.round(p.progress) + "%)…" });
      }
    };
    try {
      if (hasWebGPU) {
        kokoroTTS = await KokoroTTS.from_pretrained("onnx-community/Kokoro-82M-v1.0-ONNX", { dtype: "fp32", device: "webgpu", progress_callback });
      } else {
        kokoroTTS = await KokoroTTS.from_pretrained("onnx-community/Kokoro-82M-v1.0-ONNX", { dtype: "q8", device: "wasm", progress_callback });
      }
    } catch {
      kokoroTTS = await KokoroTTS.from_pretrained("onnx-community/Kokoro-82M-v1.0-ONNX", { dtype: "q8", device: "wasm", progress_callback });
    }
    self.postMessage({ type: "model_ready", target: "tts", engine: "kokoro" });
    return kokoroTTS;
  })();
  try { return await kokoroLoading; } finally { kokoroLoading = null; }
}

async function ensureSpeechT5() {
  if (speechT5Pipe) return speechT5Pipe;
  if (speechT5Loading) return speechT5Loading;
  speechT5Loading = (async () => {
    self.postMessage({ type: "model_progress", target: "tts", engine: "speecht5", pct: 5, status: "Loading SpeechT5 Local TTS…" });
    const { pipeline } = await import("https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.4.0/+esm");
    const progress_callback = p => {
      if (p && typeof p.progress === "number") {
        self.postMessage({ type: "model_progress", target: "tts", engine: "speecht5", pct: Math.round(p.progress), status: "Downloading SpeechT5 (" + Math.round(p.progress) + "%)…" });
      }
    };
    speechT5Pipe = await pipeline("text-to-speech", "Xenova/speecht5_tts", { dtype: "q8", device: "wasm", progress_callback });
    self.postMessage({ type: "model_ready", target: "tts", engine: "speecht5" });
    return speechT5Pipe;
  })();
  try { return await speechT5Loading; } finally { speechT5Loading = null; }
}

async function ensureWhisper(variant) {
  const modelId = variant === "whisper-base" ? "onnx-community/whisper-base" : "onnx-community/whisper-tiny";
  if (whisperPipes[modelId]) return whisperPipes[modelId];
  if (whisperLoading[modelId]) return whisperLoading[modelId];
  whisperLoading[modelId] = (async () => {
    const label = variant === "whisper-base" ? "Whisper-Base" : "Whisper-Tiny";
    self.postMessage({ type: "model_progress", target: "stt", engine: variant, pct: 5, status: "Loading " + label + " Local STT…" });
    const { pipeline } = await import("https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.4.0/+esm");
    const progress_callback = p => {
      if (p && typeof p.progress === "number") {
        self.postMessage({ type: "model_progress", target: "stt", engine: variant, pct: Math.round(p.progress), status: "Downloading " + label + " (" + Math.round(p.progress) + "%)…" });
      }
    };
    whisperPipes[modelId] = await pipeline("automatic-speech-recognition", modelId, { dtype: "q8", device: "wasm", progress_callback });
    self.postMessage({ type: "model_ready", target: "stt", engine: variant });
    return whisperPipes[modelId];
  })();
  try { return await whisperLoading[modelId]; } finally { delete whisperLoading[modelId]; }
}

self.onmessage = async e => {
  const msg = e.data || {};
  try {
    if (msg.type === "preload_tts") {
      if (msg.engine === "speecht5") await ensureSpeechT5();
      else await ensureKokoro();
    } else if (msg.type === "preload_stt") {
      await ensureWhisper(msg.engine || "whisper-tiny");
    } else if (msg.type === "synthesize") {
      if (msg.engine === "speecht5") {
        const pipe = await ensureSpeechT5();
        const speaker_embeddings = "https://huggingface.co/datasets/Xenova/transformers.js-docs/resolve/main/speaker_embeddings.bin";
        const out = await pipe(msg.text, { speaker_embeddings });
        const samples = out.audio;
        const sampleRate = out.sampling_rate || 16000;
        self.postMessage({ type: "tts_audio", id: msg.id, samples, sampleRate }, [samples.buffer]);
      } else {
        const tts = await ensureKokoro();
        const audio = await tts.generate(msg.text, { voice: msg.voice || "af_heart" });
        const samples = audio.audio;
        const sampleRate = audio.sampling_rate || 24000;
        self.postMessage({ type: "tts_audio", id: msg.id, samples, sampleRate }, [samples.buffer]);
      }
    } else if (msg.type === "transcribe") {
      const pipe = await ensureWhisper(msg.engine || "whisper-tiny");
      const lang = msg.lang === "hi-IN" ? "hindi" : "english";
      const out = await pipe(msg.pcm, { language: lang, task: "transcribe", chunk_length_s: 20 });
      self.postMessage({ type: "stt_result", id: msg.id, text: (out && out.text) ? out.text.trim() : "" });
    }
  } catch (err) {
    self.postMessage({ type: "worker_error", target: msg.type, engine: msg.engine, id: msg.id, error: String(err && err.message || err) });
  }
};
`;

let neuralWorker = null;
let kokoroReady = false;
let speechT5Ready = false;
let whisperReady = false;
let kokoroFailed = false;
let whisperFailed = false;
let neuralJobId = 0;
const pendingTTSJobs = new Map();
const pendingSTTJobs = new Map();

function getNeuralWorker() {
  if (neuralWorker) return neuralWorker;
  try {
    const blob = new Blob([NEURAL_WORKER_CODE], { type: "application/javascript" });
    const url = URL.createObjectURL(blob);
    neuralWorker = new Worker(url, { type: "module" });
    neuralWorker.onmessage = e => {
      const d = e.data || {};
      if (d.type === "model_progress") {
        showModelProgress(d.status, d.pct);
      } else if (d.type === "model_ready") {
        hideModelProgress();
        if (d.target === "tts") {
          if (d.engine === "speecht5") speechT5Ready = true;
          else kokoroReady = true;
          updateLocalButtonsUI();
          updateEngineBadge();
        }
        if (d.target === "stt") {
          whisperReady = true;
          updateLocalButtonsUI();
          updateEngineBadge();
        }
      } else if (d.type === "tts_audio") {
        const resolver = pendingTTSJobs.get(d.id);
        if (resolver) { pendingTTSJobs.delete(d.id); resolver.resolve({ samples: d.samples, sampleRate: d.sampleRate }); }
      } else if (d.type === "stt_result") {
        const resolver = pendingSTTJobs.get(d.id);
        if (resolver) { pendingSTTJobs.delete(d.id); resolver.resolve(d.text); }
      } else if (d.type === "worker_error") {
        hideModelProgress();
        if (d.target === "preload_tts" || d.target === "synthesize") kokoroFailed = true;
        if (d.target === "preload_stt" || d.target === "transcribe") whisperFailed = true;
        updateEngineBadge();
        if (d.id && pendingTTSJobs.has(d.id)) { pendingTTSJobs.get(d.id).reject(new Error(d.error)); pendingTTSJobs.delete(d.id); }
        if (d.id && pendingSTTJobs.has(d.id)) { pendingSTTJobs.get(d.id).reject(new Error(d.error)); pendingSTTJobs.delete(d.id); }
      }
    };
    neuralWorker.onerror = () => { kokoroFailed = true; whisperFailed = true; hideModelProgress(); updateEngineBadge(); };
  } catch {
    kokoroFailed = true;
    whisperFailed = true;
  }
  return neuralWorker;
}

function showModelProgress(status, pct) {
  const box = $("vsModelProgress"), st = $("vsModelStatus"), bar = $("vsModelBar");
  if (box) box.hidden = false;
  if (st) st.textContent = status;
  if (bar) bar.style.width = Math.max(5, Math.min(100, pct)) + "%";
  const dot = $("voiceEngineDot"), lbl = $("voiceEngineLabel");
  if (dot) dot.classList.add("loading");
  if (lbl) lbl.textContent = `Downloading Local AI (${pct}%)…`;
}
function hideModelProgress() {
  const box = $("vsModelProgress");
  if (box) box.hidden = true;
  const dot = $("voiceEngineDot");
  if (dot) dot.classList.remove("loading");
  updateEngineBadge();
}
function updateLocalButtonsUI() {
  const bTts = $("btnPreloadTTS"), bStt = $("btnPreloadSTT");
  if (bTts && (kokoroReady || speechT5Ready)) { bTts.textContent = "✓ Cached & Ready"; bTts.classList.add("ready"); }
  if (bStt && whisperReady) { bStt.textContent = "✓ Cached & Ready"; bStt.classList.add("ready"); }
}

/* ==========================================================================================
   VOICE PREFERENCES & TURN-BASED STATE MACHINE (CHATGPT LIVE / GEMINI LIVE STYLE)
   ========================================================================================== */
const VOICE_PREF_KEY = "angelin_voice_prefs_v3";
const SR_CTOR = window.SpeechRecognition || window.webkitSpeechRecognition || null;
const TTS_OK = ("speechSynthesis" in window) && ("SpeechSynthesisUtterance" in window);
const VOICE_LANGS = { "en-IN": "English (India)", "en-US": "English (US)", "hi-IN": "Hindi (हिन्दी)" };

function clampNum(v, lo, hi, dflt) { v = Number(v); return Number.isFinite(v) ? Math.min(hi, Math.max(lo, v)) : dflt; }
function loadVoicePrefs() { try { const p = JSON.parse(localStorage.getItem(VOICE_PREF_KEY) || "{}"); return p && typeof p === "object" && !Array.isArray(p) ? p : {}; } catch { return {}; } }

const voicePrefs = Object.assign({
  convoMode: "live-auto",      // "live-auto" (ChatGPT/Gemini Live turn-taking) or "push" (Manual Push-to-Talk)
  ttsEngine: "auto",           // "auto" | "kokoro" | "speecht5" | "system"
  kokoroVoice: "af_heart",
  sttEngine: "whisper-tiny",   // "whisper-tiny" (100% Local, zero Android mic conflict!) | "whisper-base" | "browser"
  autoPushSec: 1.5,            // Silence duration before auto-pushing in Live Auto mode
  autoSpeak: true,
  speakInChat: false,
  captionsOn: true,
  lang: "en-IN",
  voiceURI: "",
  rate: 1.0,
  pitch: 1.0,
  volume: 1.0
}, loadVoicePrefs());

if (!["live-auto", "push"].includes(voicePrefs.convoMode)) voicePrefs.convoMode = "live-auto";
if (!["auto", "kokoro", "speecht5", "system"].includes(voicePrefs.ttsEngine)) voicePrefs.ttsEngine = "auto";
if (!["whisper-tiny", "whisper-base", "browser"].includes(voicePrefs.sttEngine)) voicePrefs.sttEngine = "whisper-tiny";
if (!VOICE_LANGS[voicePrefs.lang]) voicePrefs.lang = "en-IN";
voicePrefs.autoPushSec = clampNum(voicePrefs.autoPushSec, 0.9, 3.0, 1.5);
voicePrefs.rate = clampNum(voicePrefs.rate, 0.6, 1.8, 1.0);
voicePrefs.pitch = clampNum(voicePrefs.pitch, 0.6, 1.6, 1.0);
voicePrefs.volume = clampNum(voicePrefs.volume, 0, 1, 1.0);
function saveVoicePrefs() { try { localStorage.setItem(VOICE_PREF_KEY, JSON.stringify(voicePrefs)); } catch {} }

/* Shared AudioContext */
let sharedAudioCtx = null;
function getAudioCtx() {
  if (!sharedAudioCtx) {
    const AC = window.AudioContext || window.webkitAudioContext;
    if (AC) sharedAudioCtx = new AC();
  }
  if (sharedAudioCtx && sharedAudioCtx.state === "suspended") {
    sharedAudioCtx.resume().catch(() => {});
  }
  return sharedAudioCtx;
}

/* Microphone Stream & VAD (ONLY opened for Local Whisper STT — NEVER opened during Browser SpeechRecognition!) */
let micStream = null;
let micAnalyser = null;
let micDataArray = null;
let micLevel = 0;
let whisperRecorder = null;
let whisperChunks = [];
let whisperSilenceMs = 0;
let whisperHasSpeech = false;
let whisperInterval = null;
let whisperTranscribing = false;

async function ensureMicStream() {
  if (micStream && micStream.active) return micStream;
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) return null;
  try {
    micStream = await navigator.mediaDevices.getUserMedia({
      audio: { echoCancellation: true, noiseSuppression: true, autoGainControl: true }
    });
    const ctx = getAudioCtx();
    if (ctx) {
      const src = ctx.createMediaStreamSource(micStream);
      micAnalyser = ctx.createAnalyser();
      micAnalyser.fftSize = 256;
      micAnalyser.smoothingTimeConstant = 0.75;
      src.connect(micAnalyser);
      micDataArray = new Uint8Array(micAnalyser.frequencyBinCount);
    }
    return micStream;
  } catch {
    return null;
  }
}

function stopMicStream() {
  stopWhisperCapture(false);
  if (micStream) {
    micStream.getTracks().forEach(t => t.stop());
    micStream = null;
  }
  micAnalyser = null;
  micDataArray = null;
  micLevel = 0;
}

function sampleMicLevel() {
  if (!micAnalyser || !micDataArray || micMuted || !isVoiceActive) {
    micLevel *= 0.8;
    return micLevel;
  }
  micAnalyser.getByteTimeDomainData(micDataArray);
  let sum = 0;
  for (let i = 0; i < micDataArray.length; i++) {
    const v = (micDataArray[i] - 128) / 128;
    sum += v * v;
  }
  const rms = Math.sqrt(sum / micDataArray.length);
  const norm = Math.min(1, rms * 5.5);
  micLevel = micLevel * 0.6 + norm * 0.4;
  return micLevel;
}

/* Turn-Taking State Variables */
let micMuted = false;
let speakerMuted = false;
let micBlocked = false;
let pushStandby = false;       // true when waiting for user to press Push button
let recRunning = false;
let recStartTimer = null;
let recGen = 0;
let recKillTimer = null;
let micResumeAt = 0;
let voiceSubmitting = false;
let lastVoiceSubmit = { text: "", t: 0 };
let vGenFromVoice = false;
let voiceHearing = false;
let browserInterimBuffer = "";
let browserSilenceTimer = null;
let silenceProgressPct = 0;

let voiceSpeaking = false, speechPaused = false, pauseEmulated = false, speechSession = 0, speechQueue = [], speechIdx = 0, speechErrors = 0;
let currentUtterance = null, currentAudioSource = null, ttsAnalyser = null, ttsDataArray = null, speechWatch = null, speechChunkStart = 0, speechPulse = 0;
let voiceNote = null, voiceNoteTimer = null, voiceVoices = [], voiceResizeFn = null;
let lastUserCaption = "", lastAICaption = "";

/* Clean markdown/code before speaking */
function cleanForSpeech(text) {
  let s = normalizeBrand(text);
  let codeSeen = false;
  s = s.replace(/```[\s\S]*?(```|$)/g, () => {
    if (codeSeen) return "\n";
    codeSeen = true;
    return "\nI've put the code on screen.\n";
  });
  s = s.replace(/<(script|style)[\s\S]*?<\/\1>/gi, " ")
       .replace(/<[^>]+>/g, " ")
       .replace(/!\[([^\]]*)\]\([^)]*\)/g, "$1")
       .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
       .replace(/\[\d+\]/g, "")
       .replace(/\bhttps?:\/\/\S+|\bwww\.\S+/gi, " ")
       .replace(/`([^`]*)`/g, "$1")
       .replace(/^\s{0,3}#{1,6}\s*/gm, "")
       .replace(/^\s*>+\s?/gm, "")
       .replace(/^\s*([-*_]\s*){3,}$/gm, "")
       .replace(/^\s*\|?[\s:|-]+\|[\s:|-]*$/gm, "")
       .replace(/\|/g, ", ")
       .replace(/^\s*[-*+•]\s+/gm, "")
       .replace(/(\*\*|__|~~)/g, "")
       .replace(/(^|[\s(])[*_]+([^*_\n]+?)[*_]+(?=[\s).,!?;:]|$)/g, "$1$2")
       .replace(/[*_#`~^<>[\]{}\\]/g, " ")
       .replace(/[\p{Extended_Pictographic}\p{Emoji_Modifier}️‍⃣]/gu, "");
  s = s.split(/\n+/).map(l => l.replace(/\s+/g, " ").trim()).filter(Boolean)
       .map(l => /[.!?:;,।…]["')\]]*$/.test(l) ? l : l + ".").join(" ");
  return s.replace(/\s+([.,!?;:।])/g, "$1").replace(/\s{2,}/g, " ").trim();
}

function splitLongSentence(sent, max) {
  const parts = [];
  while (sent.length > max) {
    let cut = -1;
    for (const d of [", ", "; ", ": ", " "]) {
      const i = sent.lastIndexOf(d, max - 1);
      if (i > max * 0.4) { cut = i + d.length; break; }
    }
    if (cut < 0) cut = max;
    parts.push(sent.slice(0, cut).trim());
    sent = sent.slice(cut).trim();
  }
  if (sent) parts.push(sent);
  return parts;
}
function chunkForSpeech(text, max) {
  const sentences = String(text || "").match(/.+?(?:[.!?।…]+["')\]]*(?=\s|$)|$)/gs) || [];
  const out = [];
  let cur = "";
  for (let sent of sentences) {
    sent = sent.trim();
    if (!sent) continue;
    if (sent.length > max) {
      if (cur) { out.push(cur); cur = ""; }
      out.push(...splitLongSentence(sent, max));
      continue;
    }
    if (cur && (cur + " " + sent).length > max) { out.push(cur); cur = sent; }
    else cur = cur ? cur + " " + sent : sent;
  }
  if (cur) out.push(cur);
  return out;
}

/* System Voice Ranking */
function normLang(l) { return String(l || "").replace("_", "-").toLowerCase(); }
function langFamily(l) { return normLang(l).split("-")[0]; }
function isHindiText(t) {
  const m = String(t).match(/[ऀ-ॿ]/g);
  return !!m && m.length >= Math.max(3, String(t).replace(/\s/g, "").length * 0.25);
}
function scoreSystemVoice(v, wantLang) {
  let score = 0;
  const nl = normLang(v.lang);
  const name = (v.name || "").toLowerCase();
  if (nl === wantLang) score += 40;
  else if (langFamily(nl) === langFamily(wantLang)) score += 20;
  if (/natural|neural|online|premium|enhanced|wavenet|studio/.test(name)) score += 35;
  if (/neerja|swara|aria|jenny|ava|sonia|libby|samantha|google/.test(name)) score += 20;
  if (v.default) score += 5;
  return score;
}
function pickSystemVoice(lang) {
  const fam = langFamily(lang), want = normLang(lang);
  const pool = voiceVoices.filter(v => langFamily(v.lang) === fam);
  if (!pool.length) return null;
  if (voicePrefs.voiceURI) {
    const m = pool.find(v => v.voiceURI === voicePrefs.voiceURI);
    if (m) return m;
  }
  return [...pool].sort((a, b) => scoreSystemVoice(b, want) - scoreSystemVoice(a, want))[0];
}
function refreshVoices() {
  if (!TTS_OK) { voiceVoices = []; return; }
  try { voiceVoices = speechSynthesis.getVoices() || []; } catch { voiceVoices = []; }
  renderVoiceSelect();
}
function loadVoicesWithRetry(n = 0) {
  refreshVoices();
  if (TTS_OK && !voiceVoices.length && n < 10) setTimeout(() => loadVoicesWithRetry(n + 1), 300);
}

/* Dual Captions UI */
function updateLiveUserCaption(text, interim = false) {
  const card = $("userCapCard"), el = $("userCapText"), badge = $("userCapBadge");
  if (!el) return;
  if (!text) {
    card.classList.remove("is-live");
    badge.textContent = micMuted ? "Muted" : (pushStandby ? "Standby" : "Your Turn");
    el.className = "cap-text placeholder";
    el.textContent = voicePrefs.convoMode === "push"
      ? "Tap or hold the Push button below to talk…"
      : "Speak now — auto-sends when you pause, or tap Push below…";
    return;
  }
  lastUserCaption = text;
  card.classList.toggle("is-live", interim);
  badge.textContent = interim ? "Speaking…" : "Sent";
  el.className = "cap-text" + (interim ? " interim" : "");
  el.textContent = text;
}

function updateLiveAICaption(fullText, activeIdx = -1, isLive = false) {
  const card = $("aiCapCard"), el = $("aiCapText"), badge = $("aiCapBadge");
  if (!el) return;
  if (!fullText) {
    card.classList.remove("is-live");
    badge.textContent = "Standby";
    el.className = "cap-text placeholder";
    el.textContent = "Angelin’s reply and live spoken captions will appear here…";
    return;
  }
  lastAICaption = fullText;
  card.classList.toggle("is-live", isLive);
  badge.textContent = isLive ? (speechPaused ? "Paused" : "Speaking") : "Reply";
  el.className = "cap-text";

  if (speechQueue.length > 0 && activeIdx >= 0) {
    el.innerHTML = speechQueue.map((chunk, i) => {
      const cls = i < activeIdx ? "spoken" : (i === activeIdx ? "active" : "upcoming");
      return `<span class="cap-chunk ${cls}">${esc(chunk)}</span>`;
    }).join(" ");
    const activeSpan = el.querySelector(".cap-chunk.active");
    if (activeSpan) activeSpan.scrollIntoView({ block: "nearest", behavior: "smooth" });
  } else {
    el.textContent = fullText;
    card.scrollTop = card.scrollHeight;
  }
}

/* ==========================================================================================
   TTS PLAYBACK (Kokoro-82M Local, SpeechT5 Local, & Device Local Neural)
   ========================================================================================== */
function clearWatch() { if (speechWatch) { clearInterval(speechWatch); speechWatch = null; } }
function primeSpeech() {
  getAudioCtx();
  if (!TTS_OK) return;
  try {
    const u = new SpeechSynthesisUtterance(" ");
    u.volume = 0;
    speechSynthesis.speak(u);
    micResumeAt = Math.max(micResumeAt, Date.now() + 280);
  } catch {}
}

function cancelSpeech() {
  const was = voiceSpeaking;
  speechSession++;
  clearWatch();
  if (currentAudioSource) {
    try { currentAudioSource.stop(); currentAudioSource.disconnect(); } catch {}
    currentAudioSource = null;
  }
  ttsAnalyser = null;
  ttsDataArray = null;
  speechQueue = [];
  speechIdx = 0;
  voiceSpeaking = false;
  speechPaused = false;
  pauseEmulated = false;
  currentUtterance = null;
  speechPulse = 0;
  if (TTS_OK) {
    try { speechSynthesis.cancel(); if (speechSynthesis.paused) speechSynthesis.resume(); } catch {}
  }
  if (was) micResumeAt = Date.now() + 300;
  updateVoiceUI();
  updateChatStopBtn();
  return was;
}

function endSpeech(token) {
  if (token !== speechSession) return;
  clearWatch();
  if (currentAudioSource) {
    try { currentAudioSource.stop(); currentAudioSource.disconnect(); } catch {}
    currentAudioSource = null;
  }
  ttsAnalyser = null;
  ttsDataArray = null;
  voiceSpeaking = false;
  speechPaused = false;
  pauseEmulated = false;
  if (lastAICaption) updateLiveAICaption(lastAICaption, -1, false);
  speechQueue = [];
  currentUtterance = null;
  speechPulse = 0;

  // Turn-based loop: in Live Auto mode, automatically open user's turn after Angelin finishes!
  // In Push mode, return cleanly to standby until user presses Push.
  pushStandby = (voicePrefs.convoMode === "push");
  micResumeAt = Date.now() + 420;
  syncRecognition();
  updateVoiceUI();
  updateChatStopBtn();
}

function pickLocalTTSEngine(text) {
  if (kokoroFailed) return "system";
  if (isHindiText(text) || voicePrefs.lang === "hi-IN") return "system";
  if (voicePrefs.ttsEngine === "kokoro") return "kokoro";
  if (voicePrefs.ttsEngine === "speecht5") return "speecht5";
  if (voicePrefs.ttsEngine === "auto") return (kokoroReady || speechT5Ready) ? (speechT5Ready && !kokoroReady ? "speecht5" : "kokoro") : "system";
  return "system";
}

function startSpeech(text) {
  const max = Math.max(95, Math.min(180, Math.round(175 * voicePrefs.rate)));
  const chunks = chunkForSpeech(text, max);
  if (!chunks.length) return false;
  cancelSpeech();
  const token = speechSession;
  speechQueue = chunks;
  speechIdx = 0;
  speechErrors = 0;
  voiceSpeaking = true;
  speechPaused = false;
  pauseEmulated = false;

  // Immediately lock mic OFF while Angelin speaks (ChatGPT/Gemini Live behavior)
  syncRecognition();
  if (isVoiceActive) updateLiveAICaption(text, 0, true);
  updateVoiceUI();
  updateChatStopBtn();

  const engine = pickLocalTTSEngine(text);
  if (engine === "kokoro" || engine === "speecht5") {
    speakLocalNeuralPipeline(token, engine);
  } else {
    if (!TTS_OK) {
      speakLocalNeuralPipeline(token, "kokoro");
      return true;
    }
    setTimeout(() => { if (token === speechSession && voiceSpeaking) speakSystemChunk(token); }, 80);
  }
  return true;
}

async function synthesizeLocalChunk(text, engine) {
  const w = getNeuralWorker();
  if (!w) throw new Error("Worker unavailable");
  const id = ++neuralJobId;
  return new Promise((resolve, reject) => {
    pendingTTSJobs.set(id, { resolve, reject });
    w.postMessage({ type: "synthesize", engine, id, text, voice: voicePrefs.kokoroVoice });
  });
}

async function speakLocalNeuralPipeline(token, engine) {
  const prefetched = new Map();
  const kickPrefetch = idx => {
    if (idx < speechQueue.length && !prefetched.has(idx)) {
      prefetched.set(idx, synthesizeLocalChunk(speechQueue[idx], engine));
    }
  };
  kickPrefetch(0);
  kickPrefetch(1);

  while (token === speechSession && voiceSpeaking && speechIdx < speechQueue.length) {
    if (speechPaused) {
      await new Promise(r => setTimeout(r, 120));
      continue;
    }
    const idx = speechIdx;
    if (isVoiceActive) updateLiveAICaption(lastAICaption, idx, true);
    kickPrefetch(idx + 1);
    kickPrefetch(idx + 2);

    try {
      const { samples, sampleRate } = await prefetched.get(idx);
      prefetched.delete(idx);
      if (token !== speechSession || !voiceSpeaking) return;
      await playPCMBuffer(token, samples, sampleRate);
      if (token !== speechSession || !voiceSpeaking) return;
      speechIdx++;
    } catch {
      if (token === speechSession && voiceSpeaking && TTS_OK) {
        speakSystemChunk(token);
      } else {
        endSpeech(token);
      }
      return;
    }
  }
  endSpeech(token);
}

function playPCMBuffer(token, samples, sampleRate) {
  return new Promise(resolve => {
    const ctx = getAudioCtx();
    if (!ctx) { resolve(); return; }
    const buf = ctx.createBuffer(1, samples.length, sampleRate);
    buf.getChannelData(0).set(samples);

    const src = ctx.createBufferSource();
    src.buffer = buf;
    src.playbackRate.value = voicePrefs.rate;

    const gain = ctx.createGain();
    gain.gain.value = speakerMuted ? 0 : voicePrefs.volume;

    ttsAnalyser = ctx.createAnalyser();
    ttsAnalyser.fftSize = 128;
    ttsDataArray = new Uint8Array(ttsAnalyser.frequencyBinCount);

    src.connect(gain);
    gain.connect(ttsAnalyser);
    ttsAnalyser.connect(ctx.destination);

    currentAudioSource = src;
    src.onended = () => {
      if (currentAudioSource === src) currentAudioSource = null;
      ttsAnalyser = null;
      ttsDataArray = null;
      resolve();
    };
    src.start(0);
  });
}

function speakSystemChunk(token) {
  if (token !== speechSession || !voiceSpeaking) return;
  if (speechIdx >= speechQueue.length) { endSpeech(token); return; }
  const txt = speechQueue[speechIdx];
  if (isVoiceActive) updateLiveAICaption(lastAICaption, speechIdx, true);

  const lang = isHindiText(txt) ? "hi-IN" : voicePrefs.lang;
  const v = pickSystemVoice(lang);
  let u;
  try { u = new SpeechSynthesisUtterance(txt); } catch { endSpeech(token); return; }
  u.lang = v ? v.lang : lang;
  if (v) u.voice = v;
  u.rate = voicePrefs.rate;
  u.pitch = voicePrefs.pitch;
  u.volume = speakerMuted ? 0 : voicePrefs.volume;

  let done = false, skipped = false;
  const advance = ok => {
    if (done || skipped || token !== speechSession) return;
    done = true;
    clearWatch();
    if (ok) speechErrors = 0;
    speechIdx++;
    speakSystemChunk(token);
  };
  u.onstart = () => { if (token === speechSession) updateVoiceUI(); };
  u.onboundary = () => { if (token === speechSession) speechPulse = 1; };
  u.onend = () => advance(true);
  u.onerror = e => {
    if (done || skipped || token !== speechSession) return;
    const er = e && e.error;
    if (er === "canceled" || er === "interrupted") { endSpeech(token); return; }
    speechErrors++;
    if (speechErrors >= 2) { endSpeech(token); return; }
    advance(false);
  };
  currentUtterance = u;
  speechChunkStart = Date.now();
  clearWatch();
  const limit = txt.length / (6 * Math.max(0.5, voicePrefs.rate)) * 1000 + 5000;
  speechWatch = setInterval(() => {
    if (token !== speechSession) { clearWatch(); return; }
    if (speechPaused) { speechChunkStart = Date.now(); return; }
    if (Date.now() - speechChunkStart > limit) {
      skipped = true;
      clearWatch();
      try { speechSynthesis.cancel(); } catch {}
      setTimeout(() => { if (token === speechSession && voiceSpeaking) { speechIdx++; speakSystemChunk(token); } }, 80);
    }
  }, 1000);
  try {
    if (speechSynthesis.paused && !speechPaused) speechSynthesis.resume();
    speechSynthesis.speak(u);
  } catch { endSpeech(token); }
}

function toggleSpeechPause() {
  if (!voiceSpeaking) return;
  if (!speechPaused) {
    speechPaused = true;
    if (sharedAudioCtx && currentAudioSource) sharedAudioCtx.suspend().catch(() => {});
    if (TTS_OK) {
      try { speechSynthesis.pause(); } catch {}
      const tok = speechSession;
      setTimeout(() => {
        if (tok !== speechSession || !speechPaused || currentAudioSource) return;
        let p = false;
        try { p = speechSynthesis.paused; } catch {}
        if (!p) { pauseEmulated = true; speechSession++; clearWatch(); try { speechSynthesis.cancel(); } catch {} }
      }, 200);
    }
  } else {
    speechPaused = false;
    if (sharedAudioCtx && currentAudioSource) sharedAudioCtx.resume().catch(() => {});
    if (pauseEmulated) {
      pauseEmulated = false;
      const token = speechSession;
      setTimeout(() => { if (token === speechSession && voiceSpeaking && !speechPaused) speakSystemChunk(token); }, 80);
    } else if (TTS_OK) {
      try { speechSynthesis.resume(); } catch {}
      speechChunkStart = Date.now();
    }
  }
  if (isVoiceActive && lastAICaption) updateLiveAICaption(lastAICaption, speechIdx, true);
  updateVoiceUI();
}

function toggleSpeaker() {
  speakerMuted = !speakerMuted;
  if (speakerMuted && voiceSpeaking) cancelSpeech();
  syncRecognition();
  updateVoiceUI();
}
function updateChatStopBtn() {
  const b = $("speakStopBtn");
  if (b) b.hidden = !(voiceSpeaking && !isVoiceActive);
}

/* ==========================================================================================
   TURN-BASED STT ENGINE (WHISPER LOCAL AI + ANDROID-SAFE BROWSER STT + MANUAL PUSH)
   ========================================================================================== */
function setNote(text, ms) {
  clearTimeout(voiceNoteTimer);
  voiceNote = text ? { text } : null;
  if (text) {
    const t = ms === undefined ? 4500 : ms;
    if (Number.isFinite(t)) voiceNoteTimer = setTimeout(() => { voiceNote = null; updateVoiceUI(); }, t);
  }
  updateVoiceUI();
}

function updateEngineBadge() {
  const lbl = $("voiceEngineLabel");
  if (!lbl) return;
  const ttsName = voicePrefs.ttsEngine === "speecht5" ? "SpeechT5 Local" : ((voicePrefs.ttsEngine === "kokoro" || (voicePrefs.ttsEngine === "auto" && kokoroReady)) ? "Kokoro-82M" : "Device Neural");
  const sttName = voicePrefs.sttEngine === "whisper-base" ? "Whisper-Base" : (voicePrefs.sttEngine === "whisper-tiny" ? "Whisper-Tiny" : "Browser STT");
  lbl.textContent = `${ttsName} · ${sttName}`;
}

function voiceStateNow() {
  if (!isVoiceActive) return "off";
  if (voiceSpeaking) return speechPaused ? "paused" : "speaking";
  if (isGenerating || voiceSubmitting || whisperTranscribing) return "thinking";
  if (micMuted) return "muted";
  if (pushStandby) return "standby";
  if (recRunning || whisperRecorder) return "listening";
  return "idle";
}

function updateVoiceUI() {
  const ov = $("voiceOverlay"), cont = $("voiceAContainer");
  if (!ov || !cont) return;
  const st = voiceStateNow();
  ov.dataset.vstate = st;
  cont.classList.toggle("voice-active", st === "speaking" || (st === "listening" && voiceHearing));

  const labels = {
    speaking: "Angelin is speaking (mic locked off)…",
    paused: "Paused",
    thinking: whisperTranscribing ? "Transcribing locally…" : "Angelin is thinking (mic off)…",
    muted: "Microphone muted",
    standby: "Standby — tap or hold Push button to speak",
    listening: voiceHearing
      ? (voicePrefs.convoMode === "live-auto" ? "Listening… auto-sends on pause or tap Push" : "Recording… tap Push & Send when done")
      : (voicePrefs.convoMode === "live-auto" ? "Your turn — speak now…" : "Listening… tap Push & Send when done"),
    idle: "Getting ready…",
    off: ""
  };
  const p = $("voicePrompt");
  if (p) p.textContent = (voiceNote && st !== "off") ? voiceNote.text : labels[st];

  // Update Primary Tactile Push Button
  const pushBtn = $("voicePushBtn"), pushIcon = $("voicePushIcon"), pushLbl = $("voicePushLabel"), autoBar = $("pushAutoBar");
  if (pushBtn && pushIcon && pushLbl) {
    pushBtn.className = "voice-push-btn";
    if (st === "speaking" || st === "paused") {
      pushBtn.classList.add("state-speaking");
      pushIcon.textContent = "✋";
      pushLbl.textContent = "Interrupt & Speak";
      if (autoBar) autoBar.style.width = "0%";
    } else if (st === "thinking") {
      pushBtn.classList.add("state-thinking");
      pushIcon.textContent = "■";
      pushLbl.textContent = whisperTranscribing ? "Transcribing…" : "Stop Thinking";
      if (autoBar) autoBar.style.width = "0%";
    } else if (st === "standby" || st === "muted") {
      pushIcon.textContent = "🎙️";
      pushLbl.textContent = voicePrefs.convoMode === "push" ? "Tap or Hold to Speak" : "Tap to Start Speaking";
      if (autoBar) autoBar.style.width = "0%";
    } else if (st === "listening") {
      if (voiceHearing || browserInterimBuffer.trim() || whisperHasSpeech) {
        pushBtn.classList.add("state-push-ready");
        pushIcon.textContent = "↑";
        pushLbl.textContent = "Push & Send Now";
      } else {
        pushBtn.classList.add("state-listening");
        pushIcon.textContent = "🎙️";
        pushLbl.textContent = voicePrefs.convoMode === "push" ? "Listening… Tap to Push" : "Listening… (Tap to Push)";
      }
      if (autoBar) autoBar.style.width = silenceProgressPct + "%";
    } else {
      pushIcon.textContent = "🎙️";
      pushLbl.textContent = "Tap to Speak";
      if (autoBar) autoBar.style.width = "0%";
    }
  }

  const mic = $("voiceMuteBtn");
  if (mic) {
    mic.classList.toggle("muted", micMuted || pushStandby);
    mic.classList.toggle("listening-ring", st === "listening" && !micMuted);
    mic.setAttribute("aria-pressed", String(micMuted));
  }
  const sp = $("voiceSpeakerBtn");
  if (sp) {
    sp.textContent = speakerMuted ? "🔇" : "🔊";
    sp.classList.toggle("off", speakerMuted);
    sp.setAttribute("aria-pressed", String(speakerMuted));
  }
  const pa = $("voicePauseBtn");
  if (pa) {
    pa.disabled = !voiceSpeaking;
    pa.textContent = speechPaused ? "▶" : "⏸";
  }
  const stp = $("voiceStopBtn");
  if (stp) stp.disabled = !(voiceSpeaking || isGenerating);
}

function isUsingLocalWhisper() {
  if (whisperFailed) return false;
  return voicePrefs.sttEngine === "whisper-tiny" || voicePrefs.sttEngine === "whisper-base" || !SR_CTOR;
}

function voiceWantsMic() {
  return isVoiceActive && !micMuted && !micBlocked && !pushStandby && !isGenerating && !voiceSpeaking && !voiceSubmitting && !whisperTranscribing;
}

function syncRecognition() {
  if (voiceWantsMic()) {
    if (isUsingLocalWhisper()) {
      if (!whisperRecorder && !recStartTimer) {
        const delay = Math.max(80, micResumeAt - Date.now());
        recStartTimer = setTimeout(() => { recStartTimer = null; startWhisperCapture(); }, delay);
      }
    } else if (SR_CTOR) {
      // CRITICAL ANDROID FIX: Ensure getUserMedia stream is completely stopped before starting SpeechRecognition!
      stopMicStream();
      if (!recRunning && !recStartTimer) {
        const delay = Math.max(90, micResumeAt - Date.now());
        recStartTimer = setTimeout(() => { recStartTimer = null; startBrowserRecognition(); }, delay);
      }
    }
  } else {
    if (recStartTimer) { clearTimeout(recStartTimer); recStartTimer = null; }
    clearTimeout(browserSilenceTimer);
    silenceProgressPct = 0;
    if (whisperRecorder) stopWhisperCapture(false);
    if (recRunning && recognition) {
      try { recognition.abort(); } catch {}
      clearTimeout(recKillTimer);
      recKillTimer = setTimeout(() => {
        if (recRunning && !voiceWantsMic()) { recGen++; recRunning = false; recognition = null; updateVoiceUI(); }
      }, 1800);
    }
  }
  updateVoiceUI();
}

/* Manual Push / Primary Turn Action Handler */
function triggerManualPushAction() {
  const st = voiceStateNow();

  // 1. If Angelin is speaking -> Interrupt & immediately start user's turn (Gemini Live barge-in)
  if (st === "speaking" || st === "paused") {
    cancelSpeech();
    micMuted = false;
    pushStandby = false;
    micResumeAt = Date.now() + 120;
    syncRecognition();
    return;
  }

  // 2. If Angelin is thinking -> Abort request and return to user's turn
  if (st === "thinking") {
    if (isGenerating) stopGeneration();
    return;
  }

  // 3. If Standby / Muted -> Open mic immediately for user's turn
  if (st === "standby" || st === "muted" || micBlocked) {
    micBlocked = false;
    micMuted = false;
    pushStandby = false;
    setNote(null);
    updateLiveUserCaption("", false);
    syncRecognition();
    return;
  }

  // 4. If Currently Listening -> PUSH NOW! Immediately finalize and send what user spoke
  if (st === "listening") {
    if (isUsingLocalWhisper() && whisperRecorder) {
      if (whisperHasSpeech || whisperChunks.length > 2) {
        stopWhisperCapture(true);
      } else {
        // User tapped Push without speaking yet; switch to standby
        pushStandby = true;
        syncRecognition();
      }
    } else if (recRunning && recognition) {
      const textToPush = browserInterimBuffer.trim();
      browserInterimBuffer = "";
      clearTimeout(browserSilenceTimer);
      try { recognition.abort(); } catch {}
      if (textToPush) {
        handleFinalTranscript(textToPush);
      } else {
        pushStandby = true;
        syncRecognition();
      }
    }
  }
}

/* Browser Live STT (Android Chrome Conflict-Free) */
function startBrowserRecognition() {
  if (!voiceWantsMic() || recRunning || isUsingLocalWhisper()) return;
  stopMicStream(); // Guarantee Android AudioRecord is free for Google Speech service
  if (!recognition) recognition = initBrowserSpeechRecognition();
  if (!recognition) return;
  recognition.lang = voicePrefs.lang;
  browserInterimBuffer = "";
  silenceProgressPct = 0;
  try {
    recognition.start();
    recRunning = true;
  } catch (err) {
    if (err && err.name === "InvalidStateError") { recRunning = true; }
    else if (!whisperFailed) {
      voicePrefs.sttEngine = "whisper-tiny";
      saveVoicePrefs();
      updateEngineBadge();
      setNote("Switched to 100% Local Whisper STT.", 3000);
      syncRecognition();
    }
  }
  updateVoiceUI();
}

function handleFinalTranscript(text) {
  if (voiceSubmitting || isGenerating || voiceSpeaking || !isVoiceActive) return;
  text = String(text || "").trim();
  if (!text) return;
  const now = Date.now();
  if (text === lastVoiceSubmit.text && now - lastVoiceSubmit.t < 2500) return;
  lastVoiceSubmit = { text, t: now };

  voiceSubmitting = true;
  voiceHearing = false;
  silenceProgressPct = 0;
  browserInterimBuffer = "";
  clearTimeout(browserSilenceTimer);

  // Immediately close mic as soon as user's speech is pushed!
  updateLiveUserCaption(text, false);
  syncRecognition();

  const input = $("input"), draft = input.value;
  try {
    input.value = text;
    resizeInput();
    const pr = sendMessage(true);
    if (pr && pr.catch) pr.catch(err => console.warn("voice submit", err));
  } finally {
    input.value = draft;
    resizeInput();
    voiceSubmitting = false;
  }
  syncRecognition();
}

function initBrowserSpeechRecognition() {
  if (!SR_CTOR) return null;
  const rec = new SR_CTOR(), gen = ++recGen;
  rec.continuous = true;
  rec.interimResults = true;
  rec.maxAlternatives = 1;
  rec.lang = voicePrefs.lang;
  let silenceTick = null;

  rec.onstart = () => {
    if (gen !== recGen) return;
    recRunning = true;
    updateVoiceUI();
  };
  rec.onspeechstart = () => {
    if (gen !== recGen) return;
    voiceHearing = true;
    updateVoiceUI();
  };
  rec.onresult = e => {
    if (gen !== recGen || !isVoiceActive || !voiceWantsMic()) return;
    voiceHearing = true;
    clearTimeout(browserSilenceTimer);
    clearInterval(silenceTick);

    let fullTranscript = "";
    let hasFinal = false;
    for (let i = 0; i < e.results.length; i++) {
      const r = e.results[i];
      fullTranscript += (r[0] && r[0].transcript) || "";
      if (r.isFinal) hasFinal = true;
    }
    fullTranscript = fullTranscript.trim();
    if (!fullTranscript) return;

    browserInterimBuffer = fullTranscript;
    updateLiveUserCaption(fullTranscript, true);
    updateVoiceUI();

    // In Live Auto mode, animate auto-push bar and submit after user finishes talking
    if (voicePrefs.convoMode === "live-auto") {
      const waitMs = Math.round(voicePrefs.autoPushSec * 1000);
      const started = Date.now();
      silenceTick = setInterval(() => {
        if (gen !== recGen || !voiceWantsMic()) { clearInterval(silenceTick); return; }
        silenceProgressPct = Math.min(100, Math.round(((Date.now() - started) / waitMs) * 100));
        const bar = $("pushAutoBar");
        if (bar) bar.style.width = silenceProgressPct + "%";
      }, 80);

      browserSilenceTimer = setTimeout(() => {
        clearInterval(silenceTick);
        if (gen === recGen && browserInterimBuffer && voiceWantsMic()) {
          const commit = browserInterimBuffer;
          browserInterimBuffer = "";
          try { rec.abort(); } catch {}
          handleFinalTranscript(commit);
        }
      }, hasFinal ? Math.min(waitMs, 1100) : waitMs);
    }
  };
  rec.onerror = e => {
    if (gen !== recGen) return;
    clearTimeout(browserSilenceTimer);
    clearInterval(silenceTick);
    const er = e && e.error;
    if (er === "no-speech" || er === "aborted") return;
    // If Android Google Speech fails ("audio-capture" / "service-not-allowed"), seamlessly switch to Local Whisper AI STT!
    if (!whisperFailed) {
      voicePrefs.sttEngine = "whisper-tiny";
      saveVoicePrefs();
      updateEngineBadge();
      setNote("Switched to 100% Local Whisper AI STT.", 3000);
      recRunning = false;
      syncRecognition();
    } else if (er === "not-allowed" || er === "service-not-allowed") {
      micBlocked = true;
      setNote("Microphone permission denied. Allow mic in browser settings.", Infinity);
      updateVoiceUI();
    }
  };
  rec.onend = () => {
    if (gen !== recGen) return;
    clearTimeout(recKillTimer);
    clearTimeout(browserSilenceTimer);
    clearInterval(silenceTick);
    recRunning = false;
    voiceHearing = false;
    if (browserInterimBuffer && voiceWantsMic()) {
      const commit = browserInterimBuffer;
      browserInterimBuffer = "";
      handleFinalTranscript(commit);
      return;
    }
    if (voiceWantsMic()) {
      micResumeAt = Math.max(micResumeAt, Date.now() + 250);
      syncRecognition();
    } else {
      updateVoiceUI();
    }
  };
  return rec;
}

/* Local Whisper AI Neural STT (100% In-Browser, Zero Android Conflict) */
async function startWhisperCapture() {
  if (!voiceWantsMic() || whisperRecorder) return;
  const stream = await ensureMicStream();
  if (!stream) {
    micBlocked = true;
    setNote("Microphone permission denied. Allow mic access, then tap Push.", Infinity);
    updateVoiceUI();
    return;
  }
  getNeuralWorker()?.postMessage({ type: "preload_stt", engine: voicePrefs.sttEngine });
  whisperChunks = [];
  whisperHasSpeech = false;
  whisperSilenceMs = 0;
  silenceProgressPct = 0;

  try {
    whisperRecorder = new MediaRecorder(stream);
  } catch {
    whisperFailed = true;
    voicePrefs.sttEngine = "browser";
    syncRecognition();
    return;
  }

  whisperRecorder.ondataavailable = e => {
    if (e.data && e.data.size > 0) whisperChunks.push(e.data);
  };
  whisperRecorder.start(200);
  updateVoiceUI();

  whisperInterval = setInterval(() => {
    if (!whisperRecorder || !isVoiceActive || micMuted || pushStandby) return;
    const lvl = sampleMicLevel();
    if (lvl > 0.13) {
      if (!whisperHasSpeech) {
        whisperHasSpeech = true;
        voiceHearing = true;
        updateLiveUserCaption("Listening to your voice…", true);
      }
      whisperSilenceMs = 0;
      silenceProgressPct = 0;
      updateVoiceUI();
    } else if (whisperHasSpeech) {
      whisperSilenceMs += 120;
      if (voicePrefs.convoMode === "live-auto") {
        const targetMs = voicePrefs.autoPushSec * 1000;
        silenceProgressPct = Math.min(100, Math.round((whisperSilenceMs / targetMs) * 100));
        const bar = $("pushAutoBar");
        if (bar) bar.style.width = silenceProgressPct + "%";
        if (whisperSilenceMs >= targetMs) {
          stopWhisperCapture(true);
        }
      }
    }
  }, 120);
}

function stopWhisperCapture(shouldTranscribe) {
  clearInterval(whisperInterval);
  whisperInterval = null;
  voiceHearing = false;
  silenceProgressPct = 0;
  const rec = whisperRecorder;
  whisperRecorder = null;
  if (!rec) return;

  rec.onstop = async () => {
    if (!shouldTranscribe || !whisperChunks.length || !isVoiceActive) {
      syncRecognition();
      return;
    }
    const blob = new Blob(whisperChunks, { type: rec.mimeType || "audio/webm" });
    whisperChunks = [];
    if (blob.size < 1600) { syncRecognition(); return; }

    // Close mic hardware while transcribing + AI thinking (clean turn-taking)
    stopMicStream();
    whisperTranscribing = true;
    updateLiveUserCaption("Transcribing locally with Whisper AI…", true);
    updateVoiceUI();
    try {
      const pcm = await decodeAudioTo16kMono(blob);
      const w = getNeuralWorker();
      const id = ++neuralJobId;
      const text = await new Promise((resolve, reject) => {
        pendingSTTJobs.set(id, { resolve, reject });
        w.postMessage({ type: "transcribe", engine: voicePrefs.sttEngine, id, pcm, lang: voicePrefs.lang }, [pcm.buffer]);
      });
      whisperTranscribing = false;
      if (text && text.trim() && !/^\[.*\]$|^\(.*\)$/.test(text.trim())) {
        handleFinalTranscript(text.trim());
      } else {
        updateLiveUserCaption("", false);
        if (voicePrefs.convoMode === "push") pushStandby = true;
        syncRecognition();
      }
    } catch {
      whisperTranscribing = false;
      updateLiveUserCaption("", false);
      if (voicePrefs.convoMode === "push") pushStandby = true;
      syncRecognition();
    }
  };
  try { if (rec.state !== "inactive") rec.stop(); } catch {}
}

async function decodeAudioTo16kMono(blob) {
  const arr = await blob.arrayBuffer();
  const ctx = getAudioCtx();
  const audioBuf = await ctx.decodeAudioData(arr);
  const targetRate = 16000;
  const offline = new OfflineAudioContext(1, Math.ceil(audioBuf.duration * targetRate), targetRate);
  const src = offline.createBufferSource();
  src.buffer = audioBuf;
  src.connect(offline.destination);
  src.start(0);
  const rendered = await offline.startRendering();
  return rendered.getChannelData(0);
}

/* Hooks called from generate() */
function voiceBeforeGenerate() {
  try {
    vGenFromVoice = isVoiceActive;
    cancelSpeech();
    if (isVoiceActive) {
      setNote(null);
      updateLiveAICaption("Thinking…", -1, true);
    }
    syncRecognition();
  } catch (e) { console.warn("voiceBeforeGenerate", e); }
}

function voiceAfterGenerate(outcome, answer) {
  try {
    const fromVoice = vGenFromVoice;
    vGenFromVoice = false;
    if (outcome === "ok") {
      const spoken = cleanForSpeech(answer);
      if (isVoiceActive) {
        updateLiveAICaption(spoken || answer, -1, false);
        if (!spoken) {
          pushStandby = (voicePrefs.convoMode === "push");
          setNote("Didn't get a reply. Tap Push to speak again.", 4500);
        } else if (voicePrefs.autoSpeak && !speakerMuted && startSpeech(spoken)) {
          return;
        }
      } else if (!fromVoice && voicePrefs.speakInChat && spoken) {
        if (startSpeech(spoken)) return;
      }
    } else if (isVoiceActive) {
      updateLiveAICaption("", -1, false);
      setNote(outcome === "aborted" ? "Stopped." : "Connection error. Tap Push to try again.", 4500);
    }
    pushStandby = (voicePrefs.convoMode === "push");
    syncRecognition();
  } catch (e) { console.warn("voiceAfterGenerate", e); }
}

/* Theme-Aware Reactive Background Canvas */
function startVoiceCanvas() {
  if (animFrameId) return;
  const canvas = $("voiceCanvas"), ctx = canvas.getContext("2d");
  let width = 0, height = 0, phase = 0, particles = [];
  function readThemeRGB() {
    const styles = getComputedStyle(document.body);
    const primary = (styles.getPropertyValue("--voice-a-primary-rgb") || "139,92,246").trim();
    const glow = (styles.getPropertyValue("--voice-a-glow-rgb") || "255,215,0").trim();
    return { primary, glow };
  }
  function resize() {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    width = window.innerWidth;
    height = window.innerHeight;
    canvas.width = Math.floor(width * dpr);
    canvas.height = Math.floor(height * dpr);
    canvas.style.width = width + "px";
    canvas.style.height = height + "px";
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    if (particles.length < 34) {
      for (let i = particles.length; i < 34; i++) {
        particles.push({ x: Math.random(), y: Math.random(), r: .6 + Math.random() * 1.6, a: .2 + Math.random() * .4, s: .00015 + Math.random() * .00035, p: Math.random() * Math.PI * 2 });
      }
    }
  }
  function getAudioEnergy() {
    if (voiceSpeaking && !speechPaused) {
      if (ttsAnalyser && ttsDataArray) {
        ttsAnalyser.getByteFrequencyData(ttsDataArray);
        let sum = 0;
        for (let i = 0; i < ttsDataArray.length; i++) sum += ttsDataArray[i];
        return Math.min(1, (sum / (ttsDataArray.length * 140)));
      }
      speechPulse *= 0.88;
      return Math.min(1, 0.32 + 0.25 * Math.sin(phase * 2.6) + speechPulse * 0.55);
    }
    if (!micMuted && !pushStandby && whisperRecorder) {
      return sampleMicLevel();
    }
    if (!micMuted && !pushStandby && recRunning && voiceHearing) {
      return 0.35 + 0.2 * Math.sin(phase * 4);
    }
    return 0;
  }
  function animate() {
    if (!isVoiceActive) { ctx.clearRect(0, 0, width, height); animFrameId = null; return; }
    const { primary, glow } = readThemeRGB();
    ctx.clearRect(0, 0, width, height);
    const lvl = getAudioEnergy();
    $("voiceAContainer").style.setProperty("--vl", lvl.toFixed(3));
    if (lvl > 0.12 && !voiceSpeaking && !micMuted) {
      $("voiceAContainer").classList.add("voice-active");
    }

    for (const p of particles) {
      p.p += p.s * 60;
      p.y -= p.s * (4 + lvl * 8);
      if (p.y < -0.02) p.y = 1.02;
      const alpha = p.a * (.7 + .3 * Math.sin(p.p * 4));
      ctx.beginPath();
      ctx.fillStyle = `rgba(${primary},${alpha})`;
      ctx.arc(p.x * width, p.y * height, p.r + lvl * 1.1, 0, Math.PI * 2);
      ctx.fill();
    }

    ctx.save();
    ctx.globalCompositeOperation = "screen";
    const cx = width / 2, cy = height * 0.28;
    const glowRadius = Math.min(width, height) * 0.26 * (0.95 + lvl * 0.35);
    const g = ctx.createRadialGradient(cx, cy, 0, cx, cy, glowRadius);
    g.addColorStop(0, `rgba(${primary},${0.07 + lvl * 0.14})`);
    g.addColorStop(.55, `rgba(${glow},${0.025 + lvl * 0.06})`);
    g.addColorStop(1, "rgba(0,0,0,0)");
    ctx.fillStyle = g;
    ctx.beginPath();
    ctx.arc(cx, cy, glowRadius, 0, Math.PI * 2);
    ctx.fill();

    for (let w = 0; w < 2; w++) {
      ctx.beginPath();
      ctx.lineWidth = w === 0 ? 1.4 : 0.9;
      ctx.strokeStyle = w === 0 ? `rgba(${primary},${0.14 + lvl * 0.32})` : `rgba(${glow},${0.08 + lvl * 0.22})`;
      const amp = (5 + lvl * 30) * (w === 0 ? 1 : 0.65);
      for (let x = 0; x <= width; x += 8) {
        const env = Math.sin((x / width) * Math.PI);
        const y = cy + Math.sin(x * (0.012 + w * 0.005) + phase * (1 + w * 0.4)) * amp * env;
        if (x === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.stroke();
    }
    ctx.restore();
    phase += 0.04;
    animFrameId = requestAnimationFrame(animate);
  }
  if (voiceResizeFn) window.removeEventListener("resize", voiceResizeFn);
  voiceResizeFn = resize;
  resize();
  window.addEventListener("resize", resize, { passive: true });
  animate();
}
function stopVoiceCanvas() {
  if (animFrameId) { cancelAnimationFrame(animFrameId); animFrameId = null; }
  if (voiceResizeFn) { window.removeEventListener("resize", voiceResizeFn); voiceResizeFn = null; }
}

/* ==========================================================================================
   OPEN/CLOSE VOICE OVERLAY, MODE SWITCHER & SETTINGS
   ========================================================================================== */
function renderVoiceDrawer() {
  const list = $("voiceDrawerList");
  if (!list) return;
  if (!current.messages.length) {
    list.innerHTML = '<p style="color:#9a91a8;font-size:12px">No messages yet. Speak or type below!</p>';
    return;
  }
  list.innerHTML = current.messages.map(m => `
    <div class="vd-item ${m.role === "user" ? "u" : "a"}">
      <b>${m.role === "user" ? "You" : "Angelin AI"}</b>
      <div>${esc(cleanForSpeech(m.content) || m.content)}</div>
    </div>
  `).join("");
  list.scrollTop = list.scrollHeight;
}

function setConvoMode(mode) {
  voicePrefs.convoMode = mode;
  saveVoicePrefs();
  $("modeLiveAutoBtn").classList.toggle("active", mode === "live-auto");
  $("modeLiveAutoBtn").setAttribute("aria-selected", String(mode === "live-auto"));
  $("modePushBtn").classList.toggle("active", mode === "push");
  $("modePushBtn").setAttribute("aria-selected", String(mode === "push"));

  if (mode === "push") {
    pushStandby = true;
    updateLiveUserCaption("", false);
  } else {
    pushStandby = false;
    micMuted = false;
    updateLiveUserCaption("", false);
  }
  syncRecognition();
}

function openVoiceMode() {
  if (isVoiceActive) return;
  const ov = $("voiceOverlay");
  ov.classList.add("open");
  ov.setAttribute("aria-hidden", "false");
  isVoiceActive = true;
  micMuted = false;
  micBlocked = false;
  pushStandby = (voicePrefs.convoMode === "push");
  voiceSubmitting = false;
  micResumeAt = 0;
  setNote(null);
  updateLiveUserCaption("", false);
  updateLiveAICaption("", -1, false);
  primeSpeech();
  loadVoicesWithRetry();
  syncVoiceSettingsUI();
  updateEngineBadge();
  $("voiceCanvas").style.display = "block";
  startVoiceCanvas();

  // Preload local AI engines in background worker
  if (voicePrefs.ttsEngine !== "system" && !kokoroReady && !speechT5Ready && !kokoroFailed) {
    getNeuralWorker()?.postMessage({ type: "preload_tts", engine: voicePrefs.ttsEngine === "speecht5" ? "speecht5" : "kokoro" });
  }
  if (isUsingLocalWhisper() && !whisperReady && !whisperFailed) {
    getNeuralWorker()?.postMessage({ type: "preload_stt", engine: voicePrefs.sttEngine });
  }
  syncRecognition();
}

function closeVoiceMode() {
  if (!isVoiceActive) return;
  isVoiceActive = false;
  voiceSubmitting = false;
  voiceHearing = false;
  syncRecognition();
  cancelSpeech();
  stopMicStream();
  stopVoiceCanvas();
  const ov = $("voiceOverlay");
  ov.classList.remove("open");
  ov.setAttribute("aria-hidden", "true");
  $("voiceSettingsPanel").hidden = true;
  $("voiceDrawer").hidden = true;
  setNote(null);
  updateVoiceUI();
  updateChatStopBtn();
}

function toggleMic() {
  if (voiceSpeaking) {
    cancelSpeech();
  }
  if (micBlocked) {
    micBlocked = false;
    micMuted = false;
    pushStandby = false;
    setNote(null);
  } else if (pushStandby) {
    pushStandby = false;
    micMuted = false;
    setNote(null);
  } else {
    micMuted = !micMuted;
    if (micMuted) updateLiveUserCaption("", false);
    else setNote(null);
  }
  syncRecognition();
}

function voiceStop() {
  if (voiceSpeaking) {
    cancelSpeech();
    pushStandby = (voicePrefs.convoMode === "push");
    syncRecognition();
  } else if (isGenerating) {
    stopGeneration();
  }
}

function sendVoiceTextInput() {
  const inp = $("voiceTextInput");
  if (!inp) return;
  const txt = inp.value.trim();
  if (!txt || isGenerating) return;
  inp.value = "";
  cancelSpeech();
  handleFinalTranscript(txt);
}

/* Settings Sheet */
function renderVoiceSelect() {
  const sel = $("vsVoice");
  if (!sel) return;
  const fam = langFamily(voicePrefs.lang);
  const pool = voiceVoices.filter(v => langFamily(v.lang) === fam).sort((a, b) => scoreSystemVoice(b, normLang(voicePrefs.lang)) - scoreSystemVoice(a, normLang(voicePrefs.lang)));
  sel.innerHTML = "";
  const auto = document.createElement("option");
  auto.value = "";
  auto.textContent = "Auto (Best Device Neural Match)";
  sel.appendChild(auto);
  pool.forEach(v => {
    const o = document.createElement("option");
    o.value = v.voiceURI;
    o.textContent = v.name + " (" + String(v.lang).replace("_", "-") + ")";
    sel.appendChild(o);
  });
  sel.value = pool.some(v => v.voiceURI === voicePrefs.voiceURI) ? voicePrefs.voiceURI : "";
}

function syncVoiceSettingsUI() {
  $("vsTtsEngine").value = voicePrefs.ttsEngine;
  $("vsKokoroVoice").value = voicePrefs.kokoroVoice;
  $("vsSttEngine").value = voicePrefs.sttEngine;
  $("vsAutoPushDelay").value = voicePrefs.autoPushSec;
  $("vsAutoPushVal").textContent = voicePrefs.autoPushSec.toFixed(1) + "s";
  $("vsAutoSpeak").checked = voicePrefs.autoSpeak;
  $("vsSpeakChat").checked = voicePrefs.speakInChat;
  $("vsLang").value = voicePrefs.lang;
  $("modeLiveAutoBtn").classList.toggle("active", voicePrefs.convoMode === "live-auto");
  $("modePushBtn").classList.toggle("active", voicePrefs.convoMode === "push");
  [["Rate", "rate", "×"], ["Pitch", "pitch", ""], ["Volume", "volume", ""]].forEach(([id, key, suffix]) => {
    $("vs" + id).value = voicePrefs[key];
    $("vs" + id + "Val").textContent = key === "volume" ? Math.round(voicePrefs[key] * 100) + "%" : voicePrefs[key].toFixed(2) + suffix;
  });
  renderVoiceSelect();
  updateLocalButtonsUI();
}

function bindVoiceSlider(id, key) {
  $("vs" + id).oninput = e => {
    voicePrefs[key] = clampNum(e.target.value, key === "volume" ? 0 : 0.6, key === "volume" ? 1 : (key === "rate" ? 1.8 : 1.6), 1);
    saveVoicePrefs();
    $("vs" + id + "Val").textContent = key === "volume" ? Math.round(voicePrefs[key] * 100) + "%" : voicePrefs[key].toFixed(2) + (key === "rate" ? "×" : "");
  };
}

function initVoiceSettings() {
  $("modeLiveAutoBtn").onclick = () => setConvoMode("live-auto");
  $("modePushBtn").onclick = () => setConvoMode("push");

  // Support both tap AND press-and-hold on the primary Push button
  let holdStartedAt = 0;
  const pushBtn = $("voicePushBtn");
  pushBtn.addEventListener("pointerdown", () => {
    if (voiceStateNow() === "standby" && voicePrefs.convoMode === "push") {
      holdStartedAt = Date.now();
      triggerManualPushAction();
    } else {
      holdStartedAt = 0;
    }
  });
  pushBtn.addEventListener("pointerup", () => {
    if (holdStartedAt && Date.now() - holdStartedAt > 450 && voiceStateNow() === "listening") {
      holdStartedAt = 0;
      triggerManualPushAction(); // Release after holding -> immediately push & send!
    }
  });
  pushBtn.onclick = () => {
    if (holdStartedAt) { holdStartedAt = 0; return; }
    triggerManualPushAction();
  };

  $("vsTtsEngine").onchange = e => {
    voicePrefs.ttsEngine = e.target.value;
    saveVoicePrefs();
    updateEngineBadge();
    if (voicePrefs.ttsEngine !== "system") {
      getNeuralWorker()?.postMessage({ type: "preload_tts", engine: voicePrefs.ttsEngine === "speecht5" ? "speecht5" : "kokoro" });
    }
  };
  $("vsKokoroVoice").onchange = e => { voicePrefs.kokoroVoice = e.target.value; saveVoicePrefs(); };
  $("vsSttEngine").onchange = e => {
    voicePrefs.sttEngine = e.target.value;
    saveVoicePrefs();
    updateEngineBadge();
    if (isUsingLocalWhisper()) {
      getNeuralWorker()?.postMessage({ type: "preload_stt", engine: voicePrefs.sttEngine });
    }
    syncRecognition();
  };
  $("vsAutoPushDelay").oninput = e => {
    voicePrefs.autoPushSec = clampNum(e.target.value, 0.9, 3.0, 1.5);
    saveVoicePrefs();
    $("vsAutoPushVal").textContent = voicePrefs.autoPushSec.toFixed(1) + "s";
  };
  $("btnPreloadTTS").onclick = () => {
    const eng = voicePrefs.ttsEngine === "speecht5" ? "speecht5" : "kokoro";
    getNeuralWorker()?.postMessage({ type: "preload_tts", engine: eng });
  };
  $("btnPreloadSTT").onclick = () => {
    const eng = voicePrefs.sttEngine === "whisper-base" ? "whisper-base" : "whisper-tiny";
    getNeuralWorker()?.postMessage({ type: "preload_stt", engine: eng });
  };

  $("vsAutoSpeak").onchange = e => { voicePrefs.autoSpeak = e.target.checked; saveVoicePrefs(); };
  $("vsSpeakChat").onchange = e => { voicePrefs.speakInChat = e.target.checked; saveVoicePrefs(); };
  $("vsLang").onchange = e => {
    voicePrefs.lang = e.target.value;
    voicePrefs.voiceURI = "";
    saveVoicePrefs();
    renderVoiceSelect();
    if (recRunning && recognition) { try { recognition.abort(); } catch {} }
  };
  $("vsVoice").onchange = e => { voicePrefs.voiceURI = e.target.value; saveVoicePrefs(); };
  bindVoiceSlider("Rate", "rate");
  bindVoiceSlider("Pitch", "pitch");
  bindVoiceSlider("Volume", "volume");

  $("vsTest").onclick = () => {
    if (speakerMuted) { setNote("Speaker is muted. Unmute it first.", 3500); return; }
    const sample = voicePrefs.lang === "hi-IN"
      ? "नमस्ते, मैं एंजेलिन हूँ। अब मेरी आवाज़ और लाइव कैप्शन दोनों तैयार हैं।"
      : "Hello! I'm Angelin AI. My local neural voice and turn-based live mode are ready.";
    startSpeech(sample);
  };

  $("voiceSettingsBtn").onclick = () => {
    const p = $("voiceSettingsPanel");
    $("voiceDrawer").hidden = true;
    p.hidden = !p.hidden;
    if (!p.hidden) { refreshVoices(); syncVoiceSettingsUI(); }
  };
  $("voiceSettingsClose").onclick = () => { $("voiceSettingsPanel").hidden = true; };

  $("voiceMenuBtn").onclick = () => {
    const d = $("voiceDrawer");
    $("voiceSettingsPanel").hidden = true;
    d.hidden = !d.hidden;
    if (!d.hidden) renderVoiceDrawer();
  };
  $("voiceDrawerClose").onclick = () => { $("voiceDrawer").hidden = true; };

  $("voiceCCBtn").onclick = () => {
    voicePrefs.captionsOn = !voicePrefs.captionsOn;
    saveVoicePrefs();
    $("voiceCCBtn").classList.toggle("active", voicePrefs.captionsOn);
    $("voiceCCBtn").setAttribute("aria-pressed", String(voicePrefs.captionsOn));
    $("voiceCaptionsStage").classList.toggle("hidden-cc", !voicePrefs.captionsOn);
  };
  $("voiceCCBtn").classList.toggle("active", voicePrefs.captionsOn);
  $("voiceCaptionsStage").classList.toggle("hidden-cc", !voicePrefs.captionsOn);

  if (TTS_OK) {
    try { speechSynthesis.addEventListener("voiceschanged", refreshVoices); }
    catch { speechSynthesis.onvoiceschanged = refreshVoices; }
    loadVoicesWithRetry();
  }
  syncVoiceSettingsUI();
}

/* Wiring */
$("micBtn").onclick = openVoiceMode;
$("topVoiceBtn").onclick = openVoiceMode;
$("voiceCloseBtn").onclick = closeVoiceMode;
$("voiceMuteBtn").onclick = toggleMic;
$("voiceSpeakerBtn").onclick = toggleSpeaker;
$("voicePauseBtn").onclick = toggleSpeechPause;
$("voiceStopBtn").onclick = voiceStop;
$("speakStopBtn").onclick = () => cancelSpeech();
$("voicePillSendBtn").onclick = sendVoiceTextInput;
$("voiceTextInput").addEventListener("keydown", e => {
  if (e.key === "Enter") { e.preventDefault(); sendVoiceTextInput(); }
});
initVoiceSettings();

document.addEventListener("keydown", e => {
  if (e.key === "Escape") {
    const p = $("voiceSettingsPanel"), d = $("voiceDrawer");
    if (!p.hidden) p.hidden = true;
    else if (!d.hidden) d.hidden = true;
    else if (isVoiceActive) closeVoiceMode();
  }
});
window.addEventListener("pagehide", () => { try { speechSynthesis.cancel(); } catch {} stopMicStream(); });

$("webBtn").onclick = () => {
  webMode = !webMode;
  $("webBtn").textContent = webMode ? "🌐 Web ON" : "🌐 Web OFF";
  $("webSetting").textContent = webMode ? "ON" : "OFF";
  toast(webMode ? "Web mode enabled" : "Web mode disabled");
};
$("streamBtn").onclick = () => {
  isStreamingEnabled = !isStreamingEnabled;
  $("streamBtn").textContent = isStreamingEnabled ? "⚡ Stream ON" : "⚡ Stream OFF";
  $("streamSetting").textContent = isStreamingEnabled ? "ON" : "OFF";
};
$("clearBtn").onclick = () => {
  if (confirm("Clear all chat history?")) { conversations = []; save(); renderHistory(); newChat(); }
};
$("shareBtn").onclick = () => {
  if (navigator.share) {
    navigator.share({ title: "Angelin AI Chat", text: current.messages.map(m => `${m.role === "user" ? "You" : "Angelin AI"}: ${m.content}`).join("\n\n") });
  } else {
    navigator.clipboard.writeText(window.location.href);
    toast("Chat link copied to clipboard");
  }
};
function openHistoryMenu(anchor, id) {
  menuChatId = id;
  const m = $("historyMenu"), r = anchor.getBoundingClientRect();
  m.style.display = "block";
  m.style.left = Math.min(innerWidth - 165, r.right - 155) + "px";
  m.style.top = Math.min(innerHeight - 150, r.bottom + 5) + "px";
}
function closeHistoryMenu() { $("historyMenu").style.display = "none"; menuChatId = null; }
$("renameBtn").onclick = () => {
  if (!menuChatId) return;
  const chat = conversations.find(c => c.id === menuChatId);
  if (chat) { const name = prompt("Rename chat:", chat.title); if (name) { chat.title = name; save(); renderHistory(); } }
  closeHistoryMenu();
};
$("pinBtn").onclick = () => {
  if (!menuChatId) return;
  const chat = conversations.find(c => c.id === menuChatId);
  if (chat) { chat.pinned = !chat.pinned; save(); renderHistory(); }
  closeHistoryMenu();
};
$("deleteBtn").onclick = () => {
  if (!menuChatId) return;
  conversations = conversations.filter(c => c.id !== menuChatId);
  save();
  renderHistory();
  if (current.id === menuChatId) newChat();
  closeHistoryMenu();
};
document.addEventListener("click", e => {
  if (!e.target.closest("#historyMenu") && !e.target.closest(".history-more")) closeHistoryMenu();
});
function closeMenu() { $("sidebar").classList.remove("open"); $("overlay").classList.remove("open"); }
function resizeInput() { const x = $("input"); x.style.height = "auto"; x.style.height = Math.min(x.scrollHeight, 160) + "px"; }
function bindSuggestions() {
  document.querySelectorAll(".suggestion").forEach(b => {
    b.onclick = () => { $("input").value = b.textContent.replace(/^\S+\s*/, ""); resizeInput(); sendMessage(false); };
  });
}
function applyTheme(name) {
  document.body.className = name;
  localStorage.setItem(THEME_KEY, name);
  document.querySelectorAll(".theme-card").forEach(c => c.classList.toggle("active", c.dataset.theme === name));
}
$("newChat").onclick = newChat;
$("menuBtn").onclick = () => { $("sidebar").classList.add("open"); $("overlay").classList.add("open"); };
$("overlay").onclick = closeMenu;
$("sendBtn").onclick = () => sendMessage(false);
$("input").addEventListener("input", resizeInput);
$("input").addEventListener("keydown", e => { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); sendMessage(false); } });
$("settingsBtn").onclick = () => { $("settings").hidden = false; closeMenu(); };
$("closeSettings").onclick = () => { $("settings").hidden = true; };
document.querySelectorAll(".theme-card").forEach(c => { c.onclick = () => applyTheme(c.dataset.theme); });

applyTheme(localStorage.getItem(THEME_KEY) || "theme-purple-gold");
bindSuggestions();
renderHistory();
resizeInput();
</script>
</body>
</html>
